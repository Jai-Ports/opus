c_transpiler_clz64 :: (value: $T) -> s32 { return 64 - C_Transpiler_Bit_Operations.bit_scan_reverse(cast,no_check(u64) value); }
c_transpiler_ctz32 :: (value: $T) -> s32 { return C_Transpiler_Bit_Operations.bit_scan_forward(cast,no_check(u32) value) - 1; }
c_transpiler_ctz64 :: (value: $T) -> s32 { return C_Transpiler_Bit_Operations.bit_scan_forward(cast,no_check(u64) value) - 1; }
c_transpiler_clzg :: (value: $T, zero_result: $Z) -> s32 { if value == 0 return cast,no_check(s32) zero_result; return cast(s32) (size_of(T) * 8) - C_Transpiler_Bit_Operations.bit_scan_reverse(value); }
c_transpiler_ctzg :: (value: $T, zero_result: $Z) -> s32 { if value == 0 return cast,no_check(s32) zero_result; return C_Transpiler_Bit_Operations.bit_scan_forward(value) - 1; }
c_transpiler_nontemporal_store :: (value: $T, destination: *T) { destination.* = value; }
c_transpiler_nontemporal_load :: (source: *$T) -> T { return source.*; }
c_transpiler_prefetch :: (value: $T) {}
C_Transpiler_Va_State :: struct { arguments: []Any; index: s64; }
c_transpiler_va_start :: (storage: *void, arguments: []Any) -> s64 { state := cast(*C_Transpiler_Va_State) storage; state.arguments = arguments; state.index = 0; return 0; }
c_transpiler_va_copy :: (destination: *void, source: *void) -> s64 { (cast(*C_Transpiler_Va_State) destination).* = (cast(*C_Transpiler_Va_State) source).*; return 0; }
start_variadic_arguments :: c_transpiler_va_start;
copy_variadic_arguments :: c_transpiler_va_copy;
c_transpiler_va_arg :: (storage: *void, $T: Type) -> T { state := cast(*C_Transpiler_Va_State) storage; result := (cast(*T) state.arguments[state.index].value_pointer).*; state.index += 1; return result; }
c_transpiler_exit :: (code: s32) { exit(code); }
C_Transpiler_Alloca_Block :: struct {
    previous: *C_Transpiler_Alloca_Block;
    allocator: Allocator;
    capacity: u64;
    occupied: u64;
}
C_Transpiler_Alloca_Mark :: struct {
    block: *C_Transpiler_Alloca_Block;
    occupied: u64;
}
C_TRANSPILER_ALLOCA_ALIGNMENT :: cast(u64) 16;
C_TRANSPILER_ALLOCA_INITIAL_CAPACITY :: cast(u64) (64 * 1024);
C_TRANSPILER_ALLOCA_DATA_OFFSET :: cast(u64) ((size_of(C_Transpiler_Alloca_Block) + 15) & ~15);
c_transpiler_alloca_heads: [C_TRANSPILER_TLS_SLOTS] *C_Transpiler_Alloca_Block;

c_transpiler_alloca_new_block :: (
    previous: *C_Transpiler_Alloca_Block,
    capacity: u64,
) -> *C_Transpiler_Alloca_Block {
    assert(capacity <= cast(u64) 0x7fffffffffffffff - C_TRANSPILER_ALLOCA_DATA_OFFSET,
           "c_transpiler: alloca size overflow");
    allocator := context.allocator;
    memory := alloc(
        cast(s64) (C_TRANSPILER_ALLOCA_DATA_OFFSET + capacity),,
        allocator = allocator,
    );
    assert(memory != null, "c_transpiler: alloca storage allocation failed");
    block := cast(*C_Transpiler_Alloca_Block) memory;
    block.* = .{
        previous = previous,
        allocator = allocator,
        capacity = capacity,
    };
    return block;
}

c_transpiler_alloca_checkpoint :: () -> C_Transpiler_Alloca_Mark {
    index := c_transpiler_tls_index();
    block := c_transpiler_alloca_heads[index];
    if !block {
        block = c_transpiler_alloca_new_block(
            null, C_TRANSPILER_ALLOCA_INITIAL_CAPACITY,
        );
        c_transpiler_alloca_heads[index] = block;
    }
    return .{block = block, occupied = block.occupied};
}

c_transpiler_alloca :: (size: u64) -> *void {
    assert(size <= cast(u64) 0x7fffffffffffffff - C_TRANSPILER_ALLOCA_ALIGNMENT,
           "c_transpiler: alloca size overflow");
    aligned_size := (max(size, cast(u64) 1) +
                     C_TRANSPILER_ALLOCA_ALIGNMENT - 1) &
                    ~(C_TRANSPILER_ALLOCA_ALIGNMENT - 1);
    index := c_transpiler_tls_index();
    block := c_transpiler_alloca_heads[index];
    if !block {
        block = c_transpiler_alloca_new_block(
            null, max(C_TRANSPILER_ALLOCA_INITIAL_CAPACITY, aligned_size),
        );
        c_transpiler_alloca_heads[index] = block;
    } else if aligned_size > block.capacity - block.occupied {
        grown_capacity := ifx block.capacity <= cast(u64) 0x3fffffffffffffff
            then block.capacity * 2 else aligned_size;
        block = c_transpiler_alloca_new_block(
            block, max(grown_capacity, aligned_size),
        );
        c_transpiler_alloca_heads[index] = block;
    }
    result := cast(*u8) block + C_TRANSPILER_ALLOCA_DATA_OFFSET + block.occupied;
    block.occupied += aligned_size;
    return result;
}

c_transpiler_alloca_free_block :: (block: *C_Transpiler_Alloca_Block) {
    allocator := block.allocator;
    free(block,, allocator = allocator);
}

c_transpiler_alloca_release :: (mark: C_Transpiler_Alloca_Mark) {
    assert(mark.block != null, "c_transpiler: invalid alloca checkpoint");
    index := c_transpiler_tls_index();
    head := c_transpiler_alloca_heads[index];

    // No caller allocation precedes this mark, so the newest (and therefore
    // largest) overflow block can become the reusable root for this thread.
    if mark.block.previous == null && mark.occupied == 0 &&
       head != mark.block {
        retained := head;
        cursor := head.previous;
        while cursor {
            previous := cursor.previous;
            c_transpiler_alloca_free_block(cursor);
            cursor = previous;
        }
        retained.previous = null;
        retained.occupied = 0;
        c_transpiler_alloca_heads[index] = retained;
        return;
    }

    while head != mark.block {
        assert(head != null, "c_transpiler: invalid alloca checkpoint");
        previous := head.previous;
        c_transpiler_alloca_free_block(head);
        head = previous;
    }
    assert(mark.occupied <= head.capacity,
           "c_transpiler: invalid alloca checkpoint offset");
    head.occupied = mark.occupied;
    c_transpiler_alloca_heads[index] = head;
}

c_transpiler_address_of_temporary :: (value: $T) -> *T { result := New(T); result.* = value; return result; }

C_Transpiler_Alignment_Probe :: struct(T: Type) { prefix: u8; value: T; }
c_transpiler_align_of :: ($T: Type) -> u64 #expand { return cast(u64) (size_of(C_Transpiler_Alignment_Probe(T)) - size_of(T)); }
c_transpiler_bitfield_read :: (base: *void, bit_offset: u64, width: u64, $T: Type, signed: bool) -> T {
    bytes := cast(*u8) base;
    bits: u64;
    processed: u64;
    while processed < width {
        position := bit_offset + processed;
        shift := position % 8;
        count := min(8 - shift, width - processed);
        mask := (cast(u64) 1 << count) - 1;
        chunk := (cast(u64) bytes[position / 8] >> shift) & mask;
        bits |= chunk << processed;
        processed += count;
    }
    if signed && width > 0 && width < 64 && (bits & (cast(u64) 1 << (width - 1))) != 0
        bits |= ~((cast(u64) 1 << width) - 1);
    return cast,no_check(T) bits;
}
c_transpiler_bitfield_assign :: (base: *void, bit_offset: u64, width: u64, signed: bool, source: $S, $T: Type) -> T {
    converted := cast,no_check(T) source;
    bits := cast,no_check(u64) converted;
    bytes := cast(*u8) base;
    processed: u64;
    while processed < width {
        position := bit_offset + processed;
        shift := position % 8;
        count := min(8 - shift, width - processed);
        mask := (cast(u64) 1 << count) - 1;
        chunk := (bits >> processed) & mask;
        byte_mask := cast(u8) (mask << shift);
        bytes[position / 8] = (bytes[position / 8] & ~byte_mask) | cast(u8) (chunk << shift);
        processed += count;
    }
    return c_transpiler_bitfield_read(base, bit_offset, width, T, signed);
}
c_transpiler_bitfield_increment :: (base: *void, bit_offset: u64, width: u64, signed: bool, delta: s64, $T: Type, post: bool) -> T { previous := c_transpiler_bitfield_read(base, bit_offset, width, T, signed); stored := c_transpiler_bitfield_assign(base, bit_offset, width, signed, cast,no_check(T) (cast,no_check(s64) previous + delta), T); return ifx post then previous else stored; }
c_transpiler_simd_cmpeq_s32x4 :: inline (a: [4] s32, b: [4] s32) -> [4] s32 #no_context { result: [4] s32; #if CPU == .X64 { a_address := *a; b_address := *b; result_address := *result; #asm SSE { movdqu.x value:, [a_address]; movdqu.x other:, [b_address]; pcmpeqd.x value, other; movdqu.x [result_address], value; } } else { for lane: 0..3 result[lane] = ifx a[lane] == b[lane] then cast(s32) -1 else cast(s32) 0; } return result; }
c_transpiler_simd_bitselect_f32x4 :: inline (mask: [4] float32, if_set: [4] float32, if_not_set: [4] float32) -> [4] float32 #no_context { result: [4] float32; #if CPU == .X64 { mask_address := *mask; set_address := *if_set; not_set_address := *if_not_set; result_address := *result; #asm SSE { movups.x control:, [mask_address]; movups.x chosen:, [set_address]; andps.x chosen, control; movups.x other:, [not_set_address]; andnps.x control, other; orps.x chosen, control; movups.x [result_address], chosen; } } else { mask_bits := cast,force([4] u32) mask; set_bits := cast,force([4] u32) if_set; not_bits := cast,force([4] u32) if_not_set; result_bits: [4] u32; for lane: 0..3 result_bits[lane] = (mask_bits[lane] & set_bits[lane]) | (~mask_bits[lane] & not_bits[lane]); result = cast,force([4] float32) result_bits; } return result; }
c_transpiler_simd_i128_xor_store_ref :: inline (destination: *void, left: *void, right: *void) #no_context { #if CPU == .X64 { #asm SSE { movdqu.x value:, [left]; movdqu.x other:, [right]; pxor.x value, other; movdqu.x [destination], value; } } else { destination_bytes := cast(*[16] u8) destination; left_bytes := cast(*[16] u8) left; right_bytes := cast(*[16] u8) right; for lane: 0..15 destination_bytes[lane] = left_bytes[lane] ^ right_bytes[lane]; } }
c_transpiler_simd_i128_or_store_ref :: inline (destination: *void, left: *void, right: *void) #no_context { #if CPU == .X64 { #asm SSE { movdqu.x value:, [left]; movdqu.x other:, [right]; por.x value, other; movdqu.x [destination], value; } } else { destination_bytes := cast(*[16] u8) destination; left_bytes := cast(*[16] u8) left; right_bytes := cast(*[16] u8) right; for lane: 0..15 destination_bytes[lane] = left_bytes[lane] | right_bytes[lane]; } }
c_transpiler_simd_i128_and_store_ref :: inline (destination: *void, left: *void, right: *void) #no_context { #if CPU == .X64 { #asm SSE { movdqu.x value:, [left]; movdqu.x other:, [right]; pand.x value, other; movdqu.x [destination], value; } } else { destination_bytes := cast(*[16] u8) destination; left_bytes := cast(*[16] u8) left; right_bytes := cast(*[16] u8) right; for lane: 0..15 destination_bytes[lane] = left_bytes[lane] & right_bytes[lane]; } }
c_transpiler_simd_i128_add8_store_ref :: inline (destination: *void, left: *void, right: *void) #no_context { #if CPU == .X64 { #asm SSE { movdqu.x value:, [left]; movdqu.x other:, [right]; paddb.x value, other; movdqu.x [destination], value; } } else { destination_lanes := cast(*[16] u8) destination; left_lanes := cast(*[16] u8) left; right_lanes := cast(*[16] u8) right; for lane: 0..16-1 destination_lanes[lane] = cast,no_check(u8) (left_lanes[lane] + right_lanes[lane]); } }
c_transpiler_simd_i128_add16_store_ref :: inline (destination: *void, left: *void, right: *void) #no_context { #if CPU == .X64 { #asm SSE { movdqu.x value:, [left]; movdqu.x other:, [right]; paddw.x value, other; movdqu.x [destination], value; } } else { destination_lanes := cast(*[8] u16) destination; left_lanes := cast(*[8] u16) left; right_lanes := cast(*[8] u16) right; for lane: 0..8-1 destination_lanes[lane] = cast,no_check(u16) (left_lanes[lane] + right_lanes[lane]); } }
c_transpiler_simd_i128_add32_store_ref :: inline (destination: *void, left: *void, right: *void) #no_context { #if CPU == .X64 { #asm SSE { movdqu.x value:, [left]; movdqu.x other:, [right]; paddd.x value, other; movdqu.x [destination], value; } } else { destination_lanes := cast(*[4] u32) destination; left_lanes := cast(*[4] u32) left; right_lanes := cast(*[4] u32) right; for lane: 0..4-1 destination_lanes[lane] = cast,no_check(u32) (left_lanes[lane] + right_lanes[lane]); } }
c_transpiler_simd_i128_add64_store_ref :: inline (destination: *void, left: *void, right: *void) #no_context { #if CPU == .X64 { #asm SSE { movdqu.x value:, [left]; movdqu.x other:, [right]; paddq.x value, other; movdqu.x [destination], value; } } else { destination_lanes := cast(*[2] u64) destination; left_lanes := cast(*[2] u64) left; right_lanes := cast(*[2] u64) right; for lane: 0..2-1 destination_lanes[lane] = cast,no_check(u64) (left_lanes[lane] + right_lanes[lane]); } }
c_transpiler_simd_i128_sub8_store_ref :: inline (destination: *void, left: *void, right: *void) #no_context { #if CPU == .X64 { #asm SSE { movdqu.x value:, [left]; movdqu.x other:, [right]; psubb.x value, other; movdqu.x [destination], value; } } else { destination_lanes := cast(*[16] u8) destination; left_lanes := cast(*[16] u8) left; right_lanes := cast(*[16] u8) right; for lane: 0..16-1 destination_lanes[lane] = cast,no_check(u8) (left_lanes[lane] - right_lanes[lane]); } }
c_transpiler_simd_i128_sub16_store_ref :: inline (destination: *void, left: *void, right: *void) #no_context { #if CPU == .X64 { #asm SSE { movdqu.x value:, [left]; movdqu.x other:, [right]; psubw.x value, other; movdqu.x [destination], value; } } else { destination_lanes := cast(*[8] u16) destination; left_lanes := cast(*[8] u16) left; right_lanes := cast(*[8] u16) right; for lane: 0..8-1 destination_lanes[lane] = cast,no_check(u16) (left_lanes[lane] - right_lanes[lane]); } }
c_transpiler_simd_i128_sub32_store_ref :: inline (destination: *void, left: *void, right: *void) #no_context { #if CPU == .X64 { #asm SSE { movdqu.x value:, [left]; movdqu.x other:, [right]; psubd.x value, other; movdqu.x [destination], value; } } else { destination_lanes := cast(*[4] u32) destination; left_lanes := cast(*[4] u32) left; right_lanes := cast(*[4] u32) right; for lane: 0..4-1 destination_lanes[lane] = cast,no_check(u32) (left_lanes[lane] - right_lanes[lane]); } }
c_transpiler_simd_i128_sub64_store_ref :: inline (destination: *void, left: *void, right: *void) #no_context { #if CPU == .X64 { #asm SSE { movdqu.x value:, [left]; movdqu.x other:, [right]; psubq.x value, other; movdqu.x [destination], value; } } else { destination_lanes := cast(*[2] u64) destination; left_lanes := cast(*[2] u64) left; right_lanes := cast(*[2] u64) right; for lane: 0..2-1 destination_lanes[lane] = cast,no_check(u64) (left_lanes[lane] - right_lanes[lane]); } }
c_transpiler_simd_i128_xor_add8_store_ref :: inline (destination: *void, inner_left: *void, inner_right: *void, outer: *void) #no_context { #if CPU == .X64 { #asm SSE { movdqu.x value:, [inner_left]; movdqu.x other:, [inner_right]; paddb.x value, other; movdqu.x other, [outer]; pxor.x value, other; movdqu.x [destination], value; } } else { inner: [16] u8; c_transpiler_simd_i128_add8_store_ref(cast(*void) *inner, inner_left, inner_right); c_transpiler_simd_i128_xor_store_ref(destination, cast(*void) *inner, outer); } }
c_transpiler_simd_i128_xor_add16_store_ref :: inline (destination: *void, inner_left: *void, inner_right: *void, outer: *void) #no_context { #if CPU == .X64 { #asm SSE { movdqu.x value:, [inner_left]; movdqu.x other:, [inner_right]; paddw.x value, other; movdqu.x other, [outer]; pxor.x value, other; movdqu.x [destination], value; } } else { inner: [16] u8; c_transpiler_simd_i128_add16_store_ref(cast(*void) *inner, inner_left, inner_right); c_transpiler_simd_i128_xor_store_ref(destination, cast(*void) *inner, outer); } }
