c_transpiler_long_double_from_string :: (text: *s8) -> C_Transpiler_Long_Double { negative := false; if text.* == #char "-" { negative = true; text += 1; } else if text.* == #char "+" text += 1; result: C_Transpiler_Long_Double; fractional_digits: s32; after_decimal := false; while text.* { character := text.*; if character == #char "." { after_decimal = true; text += 1; continue; } if character == #char "e" || character == #char "E" break; if character < #char "0" || character > #char "9" break; result = result * c_transpiler_long_double(10.0); result = result + c_transpiler_long_double(cast(float64) (character - #char "0")); if after_decimal fractional_digits += 1; text += 1; } exponent: s32; if text.* == #char "e" || text.* == #char "E" { text += 1; exponent_negative := false; if text.* == #char "-" { exponent_negative = true; text += 1; } else if text.* == #char "+" text += 1; while text.* >= #char "0" && text.* <= #char "9" { exponent = exponent * 10 + cast(s32) (text.* - #char "0"); text += 1; } if exponent_negative exponent = -exponent; } exponent -= fractional_digits; while exponent > 0 { result = result * c_transpiler_long_double(10.0); exponent -= 1; } while exponent < 0 { result = result / c_transpiler_long_double(10.0); exponent += 1; } if negative result = -result; return result; }
