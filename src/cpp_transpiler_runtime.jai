c_transpiler_half_mask :: u32.[0x7fff, 0x7fff, 0x7fff, 0x7fff];
c_transpiler_half_bias :: u32.[0x38000000, 0x38000000, 0x38000000, 0x38000000];
c_transpiler_half_denorm_add :: u32.[0x00800000, 0x00800000, 0x00800000, 0x00800000];
c_transpiler_half_denorm_bias :: u32.[0x38800000, 0x38800000, 0x38800000, 0x38800000];
c_transpiler_half_nan_mask :: u32.[0x7f800000, 0x7f800000, 0x7f800000, 0x7f800000];
c_transpiler_half_exponent_mask :: u32.[0x7c00, 0x7c00, 0x7c00, 0x7c00];
c_transpiler_half_sign_mask :: u32.[0x8000, 0x8000, 0x8000, 0x8000];
c_transpiler_simd_half_to_float_sse2 :: (destination: *[4] u32, source: *[4] u32, $source_byte_offset: s32) #no_context {
    #if CPU == .X64 {
        source_address := cast(*u8) source + source_byte_offset;
        mask_address := *c_transpiler_half_mask; bias_address := *c_transpiler_half_bias;
        denorm_add_address := *c_transpiler_half_denorm_add; denorm_bias_address := *c_transpiler_half_denorm_bias;
        nan_mask_address := *c_transpiler_half_nan_mask; exponent_mask_address := *c_transpiler_half_exponent_mask;
        sign_mask_address := *c_transpiler_half_sign_mask;
        #asm SSE {
            movq value:, [source_address]; pxor.x zero:, zero; punpcklwd.x value, zero;
            movdqu.x normal:, [mask_address]; pand.x normal, value; pslld.x normal, 13;
            movdqu.x bias:, [bias_address]; paddd.x normal, bias;
            movdqu.x denorm:, [denorm_add_address]; paddd.x denorm, normal;
            movdqu.x denorm_bias:, [denorm_bias_address]; subps.x denorm, denorm_bias;
            movdqu.x naninf:, [nan_mask_address]; por.x naninf, normal;
            movdqu.x exponent:, [exponent_mask_address]; pand.x exponent, value;
            movdqa.x isnan:, exponent; movdqu.x compare_mask:, [exponent_mask_address]; pcmpeqd.x isnan, compare_mask;
            movdqa.x isden:, exponent; pcmpeqd.x isden, zero;
            movdqa.x selected:, isnan; pand.x selected, naninf; pandn.x isnan, normal; por.x selected, isnan;
            movdqa.x normal, isden; pand.x normal, denorm; pandn.x isden, selected; por.x normal, isden;
            movdqu.x sign:, [sign_mask_address]; pand.x sign, value; pslld.x sign, 16; por.x normal, sign;
            movdqu.x [destination], normal;
        }
    }
}
c_transpiler_simd_shift_suffix4_store_refs :: inline (out_values: *[4] u32, out_ids: *[4] u32, values: *[4] u32, ids: *[4] u32, count: s32) #no_context {
    #if CPU == .X64 {
        if count == 0 { #asm SSE { pxor.x zero:, zero; movups.x [out_ids], zero; movups.x [out_values], zero; } }
        else if count == 1 { #asm SSE { movups.x value:, [values]; movups.x index:, [ids]; psrldq value, 12; psrldq index, 12; movups.x [out_ids], index; movups.x [out_values], value; } }
        else if count == 2 { #asm SSE { movups.x value:, [values]; movups.x index:, [ids]; psrldq value, 8; psrldq index, 8; movups.x [out_ids], index; movups.x [out_values], value; } }
        else if count == 3 { #asm SSE { movups.x value:, [values]; movups.x index:, [ids]; psrldq value, 4; psrldq index, 4; movups.x [out_ids], index; movups.x [out_values], value; } }
        else { #asm SSE { movups.x value:, [values]; movups.x index:, [ids]; movups.x [out_ids], index; movups.x [out_values], value; } }
    } else {
        saved_values := values.*; saved_ids := ids.*;
        selected_values: [4] u32; selected_ids: [4] u32;
        for lane: 0..3 { if lane < count { selected_values[lane] = saved_values[4 - count + lane]; selected_ids[lane] = saved_ids[4 - count + lane]; } else { selected_values[lane] = 0; selected_ids[lane] = 0; } }
        out_ids.* = selected_ids; out_values.* = selected_values;
    }
}
