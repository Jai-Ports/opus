c_transpiler_simd_haddps128 :: inline (a: [4] float32, b: [4] float32) -> [4] float32 #no_context { result: [4] float32; #if CPU == .X64 { left := *a; right := *b; destination := *result; #asm SSE { movups.x value:, [left]; movups.x other:, [right]; haddps.x value, other; movups.x [destination], value; } } else { result = .[a[0] + a[1], a[2] + a[3], b[0] + b[1], b[2] + b[3]]; } return result; }
c_transpiler_asm_xgetbv :: (index: u32) -> u64 { #assert(CPU == .X64); low: u32 = ---; high: u32 = ---; #asm XSAVE { mov.d counter: gpr === c, index; xgetbv upper:, lower:, counter; mov.d low, lower; mov.d high, upper; } return (cast(u64) high << 32) | cast(u64) low; }
c_transpiler_asm_rsqrtss :: inline (value: float32) -> float32 #no_context { #assert(CPU == .X64); result: float32; source := *value; destination := *result; #asm SSE { movss lane:, [source]; rsqrtss lane, lane; movss [destination], lane; } return result; }
c_transpiler_asm_cpuid :: (leaf: u32, subleaf: u32) -> [4] u32 { #assert(CPU == .X64); a: u32 = ---; b: u32 = ---; c: u32 = ---; d: u32 = ---; #asm { mov.d reg_a: gpr === a, leaf; mov.d reg_c: gpr === c, subleaf; cpuid reg_a, reg_b:, reg_c, reg_d:; mov.d a, reg_a; mov.d b, reg_b; mov.d c, reg_c; mov.d d, reg_d; } return u32.[a, b, c, d]; }
c_transpiler_asm_lzcnt64 :: inline (value: u64) -> u64 #no_context { #assert(CPU == .X64); result: u64 = ---; #asm { lzcnt result, value; } return result; }
c_transpiler_asm_lzcnt32 :: inline (value: u32) -> u32 #no_context { #assert(CPU == .X64); result: u32 = ---; #asm { lzcnt.d result, value; } return result; }
c_transpiler_asm_memory_barrier :: () #no_context { #assert(CPU == .X64); #asm { mfence; } }
c_transpiler_simd_cvtps2dq_one :: (value: float32) -> s32 { if value != value || value >= 2147483648.0 || value < -2147483648.0 return cast,no_check(s32) 0x80000000; low := C_Transpiler_Math.floor(cast(float64) value); fraction := cast(float64) value - low; rounded := low; if fraction > 0.5 rounded = low + 1; else if fraction == 0.5 { half := C_Transpiler_Math.floor(low * 0.5); if half * 2 != low rounded = low + 1; } if rounded >= 2147483648.0 || rounded < -2147483648.0 return cast,no_check(s32) 0x80000000; return cast(s32) rounded; }
c_transpiler_simd_cvtps2dq128 :: inline (a: [4] float32) -> [4] s32 { result: [4] s32; #if CPU == .X64 { source := *a; destination := *result; #asm SSE { movups.x value:, [source]; cvtps2dq.x converted:, value; movdqu.x [destination], converted; } } else { for lane: 0..3 result[lane] = c_transpiler_simd_cvtps2dq_one(a[lane]); } return result; }
c_transpiler_fma :: (a: float32, b: float32, c: float32) -> float32 #foreign C_Transpiler_LibM "fmaf";
c_transpiler_fma :: (a: float64, b: float64, c: float64) -> float64 #foreign C_Transpiler_LibM "fma";
c_transpiler_fma :: inline (a: [$N] $T, b: [N] T, c: [N] T) -> [N] T { result: [N] T; for lane: 0..N-1 result[lane] = c_transpiler_fma(a[lane], b[lane], c[lane]); return result; }
c_transpiler_tzcnt32 :: inline (value: u32) -> u32 { if value == 0 return 32; return cast(u32) (C_Transpiler_Bit_Operations.bit_scan_forward(value) - 1); }
c_transpiler_tzcnt64 :: inline (value: u64) -> u64 { if value == 0 return 64; return cast(u64) (C_Transpiler_Bit_Operations.bit_scan_forward(value) - 1); }
c_transpiler_simd_permute_pd256 :: inline (a: [4] float64, $mask: s32) -> [4] float64 { return .[a[mask & 3], a[(mask >> 2) & 3], a[(mask >> 4) & 3], a[(mask >> 6) & 3]]; }
c_transpiler_simd_cvtpd2ps256 :: inline (a: [4] float64) -> [4] float32 { #assert(CPU == .X64); result: [4] float32; source := *a; destination := *result; #asm AVX { movupd.y value:, [source]; cvtpd2ps.y narrowed:, value; movups.x [destination], narrowed; } return result; }
c_transpiler_simd_cvtps2ph128 :: inline (a: [4] float32, $mode: s32) -> [8] s16 #no_context { #assert(CPU == .X64); result: [8] s16 = ---; source := *a; destination := *result; #asm F16C { movups.x value:, [source]; cvtps2ph.x narrowed:, value, mode; movdqu.x [destination], narrowed; } return result; }
c_transpiler_simd_gatherd_d128 :: inline (source: [4] s32, base: *s32, indices: [4] s32, masks: [4] s32, $scale: s32) -> [4] s32 #no_context { #assert(CPU == .X64); result: [4] s32 = ---; source_address := *source; indices_address := *indices; masks_address := *masks; destination := *result; #asm AVX2 { movdqu.x values:, [source_address]; movdqu.x offsets:, [indices_address]; movdqu.x enabled:, [masks_address]; pgatherdd.x values, [base + offsets*scale], enabled; movdqu.x [destination], values; } return result; }
c_transpiler_simd_cmppd256 :: inline (a: [4] float64, b: [4] float64, $predicate: s32) -> [4] float64 { #assert(CPU == .X64); result: [4] float64; left := *a; right := *b; destination := *result; #asm AVX { movupd.y first:, [left]; movupd.y second:, [right]; cmppd.y value:, first, second, predicate; movupd.y [destination], value; } return result; }
c_transpiler_simd_extract_pd128 :: inline (a: [4] float64, $index: s32) -> [2] float64 { #assert(index == 0 || index == 1); return .[a[index * 2], a[index * 2 + 1]]; }
c_transpiler_simd_movmskpd256 :: inline (a: [4] float64) -> s32 { #assert(CPU == .X64); result: s32 = ---; source := *a; #asm AVX { movupd.y value:, [source]; movmskpd.y result, value; } return result; }
c_transpiler_simd_minpd256 :: inline (a: [4] float64, b: [4] float64) -> [4] float64 { #assert(CPU == .X64); result: [4] float64; left := *a; right := *b; destination := *result; #asm AVX { movupd.y first:, [left]; movupd.y second:, [right]; minpd.y value:, first, second; movupd.y [destination], value; } return result; }
c_transpiler_simd_maxpd256 :: inline (a: [4] float64, b: [4] float64) -> [4] float64 { #assert(CPU == .X64); result: [4] float64; left := *a; right := *b; destination := *result; #asm AVX { movupd.y first:, [left]; movupd.y second:, [right]; maxpd.y value:, first, second; movupd.y [destination], value; } return result; }
c_transpiler_simd_cvtpd2ps128 :: (a: [2] float64) -> [4] float32 { return .[cast(float32) a[0], cast(float32) a[1], 0, 0]; }
c_transpiler_simd_rcpps128 :: inline (a: [4] float32) -> [4] float32 #no_context { result: [4] float32; #if CPU == .X64 { a_address := *a; result_address := *result; #asm SSE { movups.x value:, [a_address]; rcpps.x value, value; movups.x [result_address], value; } } else { for lane: 0..3 result[lane] = 1.0 / a[lane]; } return result; }
c_transpiler_simd_rcpss128 :: inline (a: [4] float32) -> [4] float32 #no_context { result := a; #if CPU == .X64 { source := *a; destination := *result; #asm SSE { movups.x value:, [source]; rcpss value, value; movups.x [destination], value; } } else { result[0] = 1.0 / a[0]; } return result; }
c_transpiler_simd_rsqrtps128 :: inline (a: [4] float32) -> [4] float32 #no_context { result: [4] float32; #if CPU == .X64 { a_address := *a; result_address := *result; #asm SSE { movups.x value:, [a_address]; rsqrtps.x value, value; movups.x [result_address], value; } } else { for lane: 0..3 result[lane] = 1.0 / cast(float32) c_transpiler_libm_sqrt(cast(float64) a[lane]); } return result; }
c_transpiler_simd_rsqrtss128 :: inline (a: [4] float32) -> [4] float32 #no_context { result := a; approximate := c_transpiler_simd_rsqrtps128(a); result[0] = approximate[0]; return result; }
c_transpiler_simd_abs_signed :: (a: [$N] $T) -> [N] T { result: [N] T; for lane: 0..N-1 result[lane] = ifx a[lane] < 0 then -a[lane] else a[lane]; return result; }
c_transpiler_simd_add_sat_unsigned :: (a: [$N] $T, b: [N] T) -> [N] T { result: [N] T; maximum := ~cast(T) 0; for lane: 0..N-1 result[lane] = ifx maximum - a[lane] < b[lane] then maximum else a[lane] + b[lane]; return result; }
c_transpiler_simd_sqrt_scalar :: (a: $T) -> T { return cast(T) c_transpiler_libm_sqrt(cast(float64) a); }
c_transpiler_simd_sqrt_vector :: (a: [$N] $T) -> [N] T { result: [N] T; for lane: 0..N-1 result[lane] = cast(T) c_transpiler_libm_sqrt(cast(float64) a[lane]); return result; }
c_transpiler_simd_pshufd128 :: (a: [4] s32, mask: s32) -> [4] s32 { return .[a[mask & 3], a[(mask >> 2) & 3], a[(mask >> 4) & 3], a[(mask >> 6) & 3]]; }
c_transpiler_simd_pshufhw128 :: (a: [8] s16, mask: s32) -> [8] s16 { result := a; for lane: 0..3 result[4+lane] = a[4 + ((mask >> cast(u8) (lane*2)) & 3)]; return result; }
c_transpiler_simd_pshuflw128 :: (a: [8] s16, mask: s32) -> [8] s16 { result := a; for lane: 0..3 result[lane] = a[(mask >> cast(u8) (lane*2)) & 3]; return result; }
c_transpiler_simd_pslldqi128 :: (a: [16] s8, count: s32) -> [16] s8 { result: [16] s8; for lane: 0..15 if lane >= count && count < 16 result[lane] = a[lane-count]; return result; }
c_transpiler_simd_psrldqi128 :: (a: [16] s8, count: s32) -> [16] s8 { result: [16] s8; for lane: 0..15 if lane + count < 16 result[lane] = a[lane+count]; return result; }
c_transpiler_simd_psllwi128 :: inline (a: [8] s16, count: s32) -> [8] s16 #no_context { result: [8] s16; #if CPU == .X64 { source := *a; destination := *result; #asm SSE { movdqu.x value:, [source]; movd shift:, count; psllw.x value, shift; movdqu.x [destination], value; } } else { if count < 0 || count >= 16 return result; for lane: 0..7 result[lane] = cast,no_check(s16) (cast,no_check(u16) a[lane] << cast(u8) count); } return result; }
c_transpiler_simd_psrlwi128 :: inline (a: [8] s16, count: s32) -> [8] s16 #no_context { result: [8] s16; #if CPU == .X64 { source := *a; destination := *result; #asm SSE { movdqu.x value:, [source]; movd shift:, count; psrlw.x value, shift; movdqu.x [destination], value; } } else { if count < 0 || count >= 16 return result; for lane: 0..7 result[lane] = cast,no_check(s16) (cast,no_check(u16) a[lane] >> cast(u8) count); } return result; }
c_transpiler_simd_psrlqi128 :: inline (a: [2] s64, count: s32) -> [2] s64 #no_context {
    result: [2] s64;
    #if CPU == .X64 {
        source := *a; destination := *result;
        #asm SSE { movdqu.x value:, [source]; movd shift:, count; psrlq.x value, shift; movdqu.x [destination], value; }
    } else {
        if count < 0 || count >= 64 return result;
        for lane: 0..1 result[lane] = cast,no_check(s64) (cast,no_check(u64) a[lane] >> cast(u8) count);
    }
    return result;
}
c_transpiler_simd_psllqi128 :: inline (a: [2] s64, count: s32) -> [2] s64 #no_context {
    result: [2] s64;
    #if CPU == .X64 {
        source := *a; destination := *result;
        #asm SSE { movdqu.x value:, [source]; movd shift:, count; psllq.x value, shift; movdqu.x [destination], value; }
    } else {
        if count < 0 || count >= 64 return result;
        for lane: 0..1 result[lane] = cast,no_check(s64) (cast,no_check(u64) a[lane] << cast(u8) count);
    }
    return result;
}
c_transpiler_simd_psrawi128 :: inline (a: [8] s16, count: s32) -> [8] s16 #no_context { result: [8] s16; #if CPU == .X64 { source := *a; destination := *result; #asm SSE { movdqu.x value:, [source]; movd shift:, count; psraw.x value, shift; movdqu.x [destination], value; } } else { for lane: 0..7 result[lane] = ifx count < 0 || count >= 16 then (ifx a[lane] < 0 then -1 else 0) else a[lane] >> cast(u8) count; } return result; }
c_transpiler_simd_saturate_u8 :: (value: s32) -> u8 { if value < 0 return 0; if value > 255 return 255; return cast(u8) value; }
c_transpiler_simd_saturate_s16 :: (value: s64) -> s16 { if value < -32768 return -32768; if value > 32767 return 32767; return cast(s16) value; }
c_transpiler_simd_packuswb128 :: (a: [8] s16, b: [8] s16) -> [16] s8 { result: [16] s8; for lane: 0..7 { result[lane] = cast,no_check(s8) c_transpiler_simd_saturate_u8(a[lane]); result[8+lane] = cast,no_check(s8) c_transpiler_simd_saturate_u8(b[lane]); } return result; }
c_transpiler_simd_packsswb128 :: inline (a: [8] s16, b: [8] s16) -> [16] s8 #no_context { result: [16] s8; #if CPU == .X64 { left := *a; right := *b; destination := *result; #asm SSE { movdqu.x value:, [left]; movdqu.x other:, [right]; packsswb.x value, other; movdqu.x [destination], value; } } else { for lane: 0..7 { result[lane] = cast(s8) clamp(a[lane], -128, 127); result[lane + 8] = cast(s8) clamp(b[lane], -128, 127); } } return result; }
c_transpiler_simd_packssdw128 :: (a: [4] s32, b: [4] s32) -> [8] s16 { result: [8] s16; for lane: 0..3 { result[lane] = c_transpiler_simd_saturate_s16(a[lane]); result[4+lane] = c_transpiler_simd_saturate_s16(b[lane]); } return result; }
c_transpiler_simd_pmulhw128 :: (a: [8] s16, b: [8] s16) -> [8] s16 { result: [8] s16; for lane: 0..7 { product := cast(s32) a[lane] * cast(s32) b[lane]; result[lane] = cast,no_check(s16) (product >> 16); } return result; }
c_transpiler_simd_pmulhuw128 :: inline (a: [8] u16, b: [8] u16) -> [8] u16 #no_context {
    result: [8] u16;
    #if CPU == .X64 {
        left := *a; right := *b; destination := *result;
        #asm SSE { movdqu.x value:, [left]; movdqu.x other:, [right]; pmulhuw.x value, other; movdqu.x [destination], value; }
    } else {
        for lane: 0..7 result[lane] = cast(u16) ((cast(u32) a[lane] * cast(u32) b[lane]) >> 16);
    }
    return result;
}
c_transpiler_simd_pavgb128 :: inline (a: [16] u8, b: [16] u8) -> [16] u8 #no_context { result: [16] u8; #if CPU == .X64 { left := *a; right := *b; destination := *result; #asm SSE { movdqu.x value:, [left]; movdqu.x other:, [right]; pavgb.x value, other; movdqu.x [destination], value; } } else { for lane: 0..15 { sum := cast(u16) cast,no_check(u8) a[lane] + cast(u16) cast,no_check(u8) b[lane] + 1; result[lane] = cast(u8) (sum >> 1); } } return result; }
c_transpiler_simd_psadbw128 :: inline (a: [16] s8, b: [16] s8) -> [2] s64 #no_context {
    result: [2] s64;
    #if CPU == .X64 {
        left := *a; right := *b; destination := *result;
        #asm SSE { movdqu.x value:, [left]; movdqu.x other:, [right]; psadbw.x value, other; movdqu.x [destination], value; }
    } else {
        for lane: 0..15 {
            left := cast(s32) cast,no_check(u8) a[lane];
            right := cast(s32) cast,no_check(u8) b[lane];
            result[lane / 8] += ifx left >= right then left - right else right - left;
        }
    }
    return result;
}
c_transpiler_simd_pmuludq128 :: inline (a: [4] s32, b: [4] s32) -> [2] s64 #no_context {
    result: [2] s64;
    #if CPU == .X64 {
        left := *a; right := *b; destination := *result;
        #asm SSE { movdqu.x value:, [left]; movdqu.x other:, [right]; pmuludq.x value, other; movdqu.x [destination], value; }
    } else {
        for lane: 0..1 {
            left := cast(u64) cast,no_check(u32) a[lane * 2];
            right := cast(u64) cast,no_check(u32) b[lane * 2];
            result[lane] = cast,no_check(s64) (left * right);
        }
    }
    return result;
}
c_transpiler_rotate_left32 :: inline (value: u32, count: u32) -> u32 #no_context {
    shift := cast(u8) (count & 31);
    return (value << shift) | (value >> ((32 - shift) & 31));
}
c_transpiler_rotate_left64 :: inline (value: u64, count: u64) -> u64 #no_context {
    shift := cast(u8) (count & 63);
    return (value << shift) | (value >> ((64 - shift) & 63));
}
c_transpiler_is_aligned :: inline (value: $T, alignment: $A) -> bool #no_context {
    return (cast(u64) value & (cast(u64) alignment - 1)) == 0;
}
c_transpiler_get_mxcsr :: inline () -> u32 #no_context {
    #assert(CPU == .X64);
    value: u32; address := *value;
    #asm SSE { stmxcsr [address]; }
    return value;
}
c_transpiler_set_mxcsr :: inline (value: u32) #no_context {
    #assert(CPU == .X64);
    address := *value;
    #asm SSE { ldmxcsr [address]; }
}
c_transpiler_simd_pmaddwd128 :: (a: [8] s16, b: [8] s16) -> [4] s32 { result: [4] s32; for lane: 0..3 { first := cast(s64) a[lane*2] * cast(s64) b[lane*2]; second := cast(s64) a[lane*2+1] * cast(s64) b[lane*2+1]; result[lane] = cast,no_check(s32) (first + second); } return result; }
c_transpiler_vector_shuffle_dynamic :: inline (source: [$N] $T, mask: [$M] $I) -> [M] T #no_context { result: [M] T; for lane: 0..M-1 result[lane] = source[cast,no_check(u64) mask[lane] % cast(u64) N]; return result; }
c_transpiler_simd_pshufb128 :: inline (a: [16] s8, b: [16] s8) -> [16] s8 #no_context { result: [16] s8; #if CPU == .X64 { source := *a; mask := *b; destination := *result; #asm SSE { movdqu.x value:, [source]; movdqu.x selection:, [mask]; pshufb.x value, selection; movdqu.x [destination], value; } } else { for lane: 0..15 { selection := cast,no_check(u8) b[lane]; result[lane] = ifx selection & 0x80 then 0 else a[selection & 15]; } } return result; }
c_transpiler_simd_palignr128 :: (a: [16] s8, b: [16] s8, count: s32) -> [16] s8 { result: [16] s8; for lane: 0..15 { source := lane + count; if source < 16 result[lane] = b[source]; else if source < 32 result[lane] = a[source-16]; } return result; }
c_transpiler_min_number :: inline (a: $T, b: T) -> T { #if T == float32 || T == float64 { if c_transpiler_isnan(a) != 0 return b; if c_transpiler_isnan(b) != 0 return a; return ifx c_transpiler_float_less_equal(a, b) then a else b; } else return ifx a < b then a else b; }
c_transpiler_max_number :: inline (a: $T, b: T) -> T { #if T == float32 || T == float64 { if c_transpiler_isnan(a) != 0 return b; if c_transpiler_isnan(b) != 0 return a; return ifx c_transpiler_float_greater_equal(a, b) then a else b; } else return ifx a > b then a else b; }
c_transpiler_vector_min_number :: inline (a: [$N] $T, b: [N] T) -> [N] T { result: [N] T; #if CPU == .X64 && T == float32 && N == 4 { left := *a; right := *b; destination := *result; #asm SSE { movups.x first:, [left]; movups.x second:, [right]; movups.x mask:, first; cmpps.x mask, first, 3; movups.x value:, second; minps.x value, first; andps.x second, mask; andnps.x mask, value; orps.x second, mask; movups.x [destination], second; } } else #if CPU == .X64 && T == float64 && N == 2 { left := *a; right := *b; destination := *result; #asm SSE { movupd.x first:, [left]; movupd.x second:, [right]; movupd.x mask:, first; cmppd.x mask, first, 3; movupd.x value:, second; minpd.x value, first; andpd.x second, mask; andnpd.x mask, value; orpd.x second, mask; movupd.x [destination], second; } } else { for lane: 0..N-1 result[lane] = c_transpiler_min_number(a[lane], b[lane]); } return result; }
c_transpiler_vector_max_number :: inline (a: [$N] $T, b: [N] T) -> [N] T { result: [N] T; #if CPU == .X64 && T == float32 && N == 4 { left := *a; right := *b; destination := *result; #asm SSE { movups.x first:, [left]; movups.x second:, [right]; movups.x mask:, first; cmpps.x mask, first, 3; movups.x value:, second; maxps.x value, first; andps.x second, mask; andnps.x mask, value; orps.x second, mask; movups.x [destination], second; } } else #if CPU == .X64 && T == float64 && N == 2 { left := *a; right := *b; destination := *result; #asm SSE { movupd.x first:, [left]; movupd.x second:, [right]; movupd.x mask:, first; cmppd.x mask, first, 3; movupd.x value:, second; maxpd.x value, first; andpd.x second, mask; andnpd.x mask, value; orpd.x second, mask; movupd.x [destination], second; } } else { for lane: 0..N-1 result[lane] = c_transpiler_max_number(a[lane], b[lane]); } return result; }
c_transpiler_simd_min :: inline (a: [$N] $T, b: [N] T) -> [N] T { result: [N] T; #if CPU == .X64 && T == float32 && N == 4 { left := *a; right := *b; destination := *result; #asm SSE { movups.x value:, [left]; movups.x other:, [right]; minps.x value, other; movups.x [destination], value; } } else #if CPU == .X64 && T == float64 && N == 2 { left := *a; right := *b; destination := *result; #asm SSE { movupd.x value:, [left]; movupd.x other:, [right]; minpd.x value, other; movupd.x [destination], value; } } else { for lane: 0..N-1 { #if T == float32 || T == float64 result[lane] = ifx c_transpiler_float_less(a[lane], b[lane]) then a[lane] else b[lane]; else result[lane] = ifx a[lane] < b[lane] then a[lane] else b[lane]; } } return result; }
c_transpiler_simd_max :: inline (a: [$N] $T, b: [N] T) -> [N] T { result: [N] T; #if CPU == .X64 && T == float32 && N == 4 { left := *a; right := *b; destination := *result; #asm SSE { movups.x value:, [left]; movups.x other:, [right]; maxps.x value, other; movups.x [destination], value; } } else #if CPU == .X64 && T == float64 && N == 2 { left := *a; right := *b; destination := *result; #asm SSE { movupd.x value:, [left]; movupd.x other:, [right]; maxpd.x value, other; movupd.x [destination], value; } } else { for lane: 0..N-1 { #if T == float32 || T == float64 result[lane] = ifx c_transpiler_float_greater(a[lane], b[lane]) then a[lane] else b[lane]; else result[lane] = ifx a[lane] > b[lane] then a[lane] else b[lane]; } } return result; }
c_transpiler_simd_blendv_float64 :: (a: [$N] float64, b: [N] float64, mask: [N] float64) -> [N] float64 { result: [N] float64; for lane: 0..N-1 result[lane] = ifx ((cast(*u64) *mask[lane]).* >> 63) != 0 then b[lane] else a[lane]; return result; }
c_transpiler_simd_blendv_float32 :: (a: [$N] float32, b: [N] float32, mask: [N] float32) -> [N] float32 { result: [N] float32; for lane: 0..N-1 result[lane] = ifx ((cast(*u32) *mask[lane]).* >> 31) != 0 then b[lane] else a[lane]; return result; }
c_transpiler_simd_blendv_s8 :: (a: [$N] s8, b: [N] s8, mask: [N] s8) -> [N] s8 { result: [N] s8; for lane: 0..N-1 result[lane] = ifx mask[lane] < 0 then b[lane] else a[lane]; return result; }
c_transpiler_simd_pmuldq128 :: (a: [4] s32, b: [4] s32) -> [2] s64 { return .[cast(s64) a[0] * cast(s64) b[0], cast(s64) a[2] * cast(s64) b[2]]; }
c_transpiler_simd_ptestz128 :: (a: [2] s64, b: [2] s64) -> s32 { return ifx (a[0] & b[0]) == 0 && (a[1] & b[1]) == 0 then cast(s32) 1 else cast(s32) 0; }
c_transpiler_simd_ptestc128 :: (a: [2] s64, b: [2] s64) -> s32 { return ifx ((~a[0]) & b[0]) == 0 && ((~a[1]) & b[1]) == 0 then cast(s32) 1 else cast(s32) 0; }
c_transpiler_simd_ptestnzc128 :: (a: [2] s64, b: [2] s64) -> s32 { z := c_transpiler_simd_ptestz128(a,b); c := c_transpiler_simd_ptestc128(a,b); return ifx z == 0 && c == 0 then cast(s32) 1 else cast(s32) 0; }
c_transpiler_simd_saturate_u16 :: (value: s32) -> u16 { if value < 0 return 0; if value > 65535 return 65535; return cast(u16) value; }
c_transpiler_simd_packusdw128 :: (a: [4] s32, b: [4] s32) -> [8] s16 { result: [8] s16; for lane: 0..3 { result[lane] = cast,no_check(s16) c_transpiler_simd_saturate_u16(a[lane]); result[4+lane] = cast,no_check(s16) c_transpiler_simd_saturate_u16(b[lane]); } return result; }
c_transpiler_simd_phminposuw128 :: (a: [8] s16) -> [8] s16 { result: [8] s16; best := cast,force(u16) a[0]; index: u16; for lane: 1..7 { candidate := cast,force(u16) a[lane]; if candidate < best { best = candidate; index = cast(u16) lane; } } result[0] = cast,force(s16) best; result[1] = cast,force(s16) index; return result; }
c_transpiler_crc32c :: (crc: $C, value: $T) -> C { result := cast(u32) crc; bytes := cast(*u8) *value; for byte_index: 0..size_of(T)-1 { result ^= cast(u32) bytes[byte_index]; for _: 0..7 result = ifx (result & 1) != 0 then (result >> 1) ^ 0x82f63b78 else result >> 1; } return cast(C) result; }
c_transpiler_simd_blend_imm :: (a: [$N] $T, b: [N] T, mask: s32) -> [N] T { result: [N] T; for lane: 0..N-1 result[lane] = ifx (mask & (1 << cast(u8) lane)) != 0 then b[lane] else a[lane]; return result; }
c_transpiler_simd_dppd :: (a: [2] float64, b: [2] float64, mask: s32) -> [2] float64 { sum: float64; for lane: 0..1 if (mask & (1 << cast(u8) (lane+4))) != 0 sum += a[lane]*b[lane]; result: [2] float64; for lane: 0..1 if (mask & (1 << cast(u8) lane)) != 0 result[lane]=sum; return result; }
c_transpiler_simd_dpps :: (a: [4] float32, b: [4] float32, mask: s32) -> [4] float32 { sum: float32; for lane: 0..3 if (mask & (1 << cast(u8) (lane+4))) != 0 sum += a[lane]*b[lane]; result: [4] float32; for lane: 0..3 if (mask & (1 << cast(u8) lane)) != 0 result[lane]=sum; return result; }
c_transpiler_simd_insertps128 :: (a: [4] float32, b: [4] float32, mask: s32) -> [4] float32 { result := a; source := (mask >> 6) & 3; destination := (mask >> 4) & 3; result[destination] = b[source]; for lane: 0..3 if (mask & (1 << cast(u8) lane)) != 0 result[lane]=0; return result; }
c_transpiler_simd_mpsadbw128 :: (a: [16] s8, b: [16] s8, mask: s32) -> [8] s16 { result: [8] s16; a_base := ((mask >> 2) & 1)*4; b_base := (mask & 3)*4; for lane: 0..7 { sum: s32; for byte: 0..3 { left := cast(s32) cast(u8) a[a_base+lane+byte]; right := cast(s32) cast(u8) b[b_base+byte]; sum += ifx left >= right then left-right else right-left; } result[lane]=cast(s16) sum; } return result; }
c_transpiler_simd_round_one :: (value: $T, mode: s32) -> T { kind := mode & 3; as64 := cast(float64) value; rounded: float64; if kind == 1 rounded=C_Transpiler_Math.floor(as64); else if kind == 2 rounded=C_Transpiler_Math.ceil(as64); else if kind == 3 rounded=ifx as64 < 0 then C_Transpiler_Math.ceil(as64) else C_Transpiler_Math.floor(as64); else { low := C_Transpiler_Math.floor(as64); fraction := as64-low; if fraction < 0.5 rounded=low; else if fraction > 0.5 rounded=low+1; else { half := C_Transpiler_Math.floor(low*0.5); rounded=ifx half*2 == low then low else low+1; } } return cast(T) rounded; }
c_transpiler_simd_round_packed :: (a: [$N] $T, mode: s32) -> [N] T { result: [N] T; for lane:0..N-1 result[lane]=c_transpiler_simd_round_one(a[lane],mode); return result; }
c_transpiler_simd_round_scalar :: (a: [$N] $T, b: [N] T, mode: s32) -> [N] T { result:=a; result[0]=c_transpiler_simd_round_one(b[0],mode); return result; }
c_transpiler_simd_cvtss2si32 :: (a: [4] float32) -> s32 { value := c_transpiler_libm_lrintf(a[0]); if value < -2147483648 || value > 2147483647 return cast,force(s32) cast(u32) 0x80000000; return cast(s32) value; }
c_transpiler_simd_cvtss2si64 :: (a: [4] float32) -> s64 { return c_transpiler_libm_lrintf(a[0]); }
c_transpiler_simd_extract :: (a: [$N] $T, index: s32) -> T { return a[index]; }
c_transpiler_simd_insert :: (a: [$N] $T, value: T, index: s32) -> [N] T { result:=a; result[index]=value; return result; }
C_Transpiler_Pcmp_Result :: struct { bits: u16; a_length: s32; b_length: s32; maximum: s32; }
c_transpiler_pcmp_element :: (value: *[16] s8, index: s64, words: bool, signed: bool) -> s32 { bytes:=cast(*u8)value; if words { raw:=cast(u16)bytes[index*2] | (cast(u16)bytes[index*2+1]<<8); return ifx signed then cast(s32)(cast(*s16)*raw).* else cast(s32)raw; } raw:=bytes[index]; return ifx signed then cast(s32)(cast(*s8)*raw).* else cast(s32)raw; }
c_transpiler_pcmp_core :: (a: [16] s8, input_a_length: s32, b: [16] s8, input_b_length: s32, mode: s32, explicit: bool) -> C_Transpiler_Pcmp_Result { words:=(mode&1)!=0; signed:=(mode&2)!=0; maximum:=ifx words then cast(s32)8 else cast(s32)16; a_length:=maximum; b_length:=maximum; if explicit { a64:=cast(s64)input_a_length; b64:=cast(s64)input_b_length; if a64<0 a64=-a64; if b64<0 b64=-b64; a_length=cast(s32)min(a64,cast(s64)maximum); b_length=cast(s32)min(b64,cast(s64)maximum); } else { for lane:0..maximum-1 if c_transpiler_pcmp_element(*a,lane,words,signed)==0 { a_length=cast(s32)lane; break; } for lane:0..maximum-1 if c_transpiler_pcmp_element(*b,lane,words,signed)==0 { b_length=cast(s32)lane; break; } } comparison:=(mode>>2)&3; bits:u16; for output:0..maximum-1 { matched:=false; if comparison==0 { if output<b_length for candidate:0..a_length-1 if c_transpiler_pcmp_element(*b,output,words,signed)==c_transpiler_pcmp_element(*a,candidate,words,signed) { matched=true; break; } } else if comparison==1 { if output<b_length { value:=c_transpiler_pcmp_element(*b,output,words,signed); pair:=0; while pair+1<a_length { low:=c_transpiler_pcmp_element(*a,pair,words,signed); high:=c_transpiler_pcmp_element(*a,pair+1,words,signed); if value>=low && value<=high { matched=true; break; } pair+=2; } } } else if comparison==2 { if output<a_length && output<b_length matched=c_transpiler_pcmp_element(*a,output,words,signed)==c_transpiler_pcmp_element(*b,output,words,signed); else if output>=a_length && output>=b_length matched=true; } else { matched=true; for candidate:0..a_length-1 { if output+candidate>=b_length || c_transpiler_pcmp_element(*a,candidate,words,signed)!=c_transpiler_pcmp_element(*b,output+candidate,words,signed) { matched=false; break; } } } if matched bits|=cast(u16)1<<cast(u8)output; } polarity:=(mode>>4)&3; valid_mask:u16; if b_length>=16 valid_mask=0xffff; else if b_length>0 valid_mask=(cast(u16)1<<cast(u8)b_length)-1; if polarity==1 bits=~bits; else if polarity==3 bits^=valid_mask; if maximum==8 bits&=0xff; return .{bits=bits,a_length=a_length,b_length=b_length,maximum=maximum}; }
c_transpiler_pcmp_mask :: (result: C_Transpiler_Pcmp_Result, mode: s32) -> [16] s8 { bytes:[16]s8; if (mode&64)==0 { (cast(*u16)*bytes[0]).*=result.bits; } else if (mode&1)==0 { for lane:0..15 if (result.bits&(cast(u16)1<<cast(u8)lane))!=0 bytes[lane]=-1; } else { words:=cast(*s16)*bytes[0]; for lane:0..7 if (result.bits&(cast(u16)1<<cast(u8)lane))!=0 words[lane]=-1; } return bytes; }
c_transpiler_pcmp_index :: (result: C_Transpiler_Pcmp_Result, mode: s32) -> s32 { if result.bits==0 return result.maximum; if (mode&64)==0 { for lane:0..result.maximum-1 if (result.bits&(cast(u16)1<<cast(u8)lane))!=0 return cast(s32)lane; } else { lane:=result.maximum-1; while lane>=0 { if (result.bits&(cast(u16)1<<cast(u8)lane))!=0 return cast(s32)lane; lane-=1; } } return result.maximum; }
c_transpiler_pcmpestrm128 :: (a:[16]s8,la:s32,b:[16]s8,lb:s32,mode:s32)->[16]s8 { return c_transpiler_pcmp_mask(c_transpiler_pcmp_core(a,la,b,lb,mode,true),mode); }
c_transpiler_pcmpestria128 :: (a:[16]s8,la:s32,b:[16]s8,lb:s32,mode:s32)->s32 { r:=c_transpiler_pcmp_core(a,la,b,lb,mode,true); return ifx r.bits==0 && r.b_length==r.maximum then cast(s32)1 else cast(s32)0; }
c_transpiler_pcmpestric128 :: (a:[16]s8,la:s32,b:[16]s8,lb:s32,mode:s32)->s32 { return ifx c_transpiler_pcmp_core(a,la,b,lb,mode,true).bits!=0 then cast(s32)1 else cast(s32)0; }
c_transpiler_pcmpestrio128 :: (a:[16]s8,la:s32,b:[16]s8,lb:s32,mode:s32)->s32 { return cast(s32)(c_transpiler_pcmp_core(a,la,b,lb,mode,true).bits&1); }
c_transpiler_pcmpestris128 :: (a:[16]s8,la:s32,b:[16]s8,lb:s32,mode:s32)->s32 { r:=c_transpiler_pcmp_core(a,la,b,lb,mode,true); return ifx r.a_length<r.maximum then cast(s32)1 else cast(s32)0; }
c_transpiler_pcmpestriz128 :: (a:[16]s8,la:s32,b:[16]s8,lb:s32,mode:s32)->s32 { r:=c_transpiler_pcmp_core(a,la,b,lb,mode,true); return ifx r.b_length<r.maximum then cast(s32)1 else cast(s32)0; }
c_transpiler_pcmpistrm128 :: (a:[16]s8,b:[16]s8,mode:s32)->[16]s8 { return c_transpiler_pcmp_mask(c_transpiler_pcmp_core(a,0,b,0,mode,false),mode); }
c_transpiler_pcmpistri128 :: (a:[16]s8,b:[16]s8,mode:s32)->s32 { return c_transpiler_pcmp_index(c_transpiler_pcmp_core(a,0,b,0,mode,false),mode); }
c_transpiler_pcmpistria128 :: (a:[16]s8,b:[16]s8,mode:s32)->s32 { r:=c_transpiler_pcmp_core(a,0,b,0,mode,false); return ifx r.bits==0 && r.b_length==r.maximum then cast(s32)1 else cast(s32)0; }
c_transpiler_pcmpistric128 :: (a:[16]s8,b:[16]s8,mode:s32)->s32 { return ifx c_transpiler_pcmp_core(a,0,b,0,mode,false).bits!=0 then cast(s32)1 else cast(s32)0; }
c_transpiler_pcmpistrio128 :: (a:[16]s8,b:[16]s8,mode:s32)->s32 { return cast(s32)(c_transpiler_pcmp_core(a,0,b,0,mode,false).bits&1); }
c_transpiler_pcmpistris128 :: (a:[16]s8,b:[16]s8,mode:s32)->s32 { r:=c_transpiler_pcmp_core(a,0,b,0,mode,false); return ifx r.a_length<r.maximum then cast(s32)1 else cast(s32)0; }
c_transpiler_pcmpistriz128 :: (a:[16]s8,b:[16]s8,mode:s32)->s32 { r:=c_transpiler_pcmp_core(a,0,b,0,mode,false); return ifx r.b_length<r.maximum then cast(s32)1 else cast(s32)0; }
c_transpiler_aes_multiply :: (left: u8, right: u8) -> u8 { result:u8; a:=left; b:=right; while b!=0 { if (b&1)!=0 result^=a; high:=(a&0x80)!=0; a<<=1; if high a^=0x1b; b>>=1; } return result; }
c_transpiler_aes_rotate_byte :: (value:u8, count:u8)->u8 { return cast,no_check(u8)((cast(u16)value<<count)|(cast(u16)value>>(8-count))); }
c_transpiler_aes_sbox :: (value:u8)->u8 { inverse:u8; if value!=0 { inverse=1; power:=value; exponent:=254; while exponent!=0 { if (exponent&1)!=0 inverse=c_transpiler_aes_multiply(inverse,power); power=c_transpiler_aes_multiply(power,power); exponent>>=1; } } return inverse^c_transpiler_aes_rotate_byte(inverse,1)^c_transpiler_aes_rotate_byte(inverse,2)^c_transpiler_aes_rotate_byte(inverse,3)^c_transpiler_aes_rotate_byte(inverse,4)^0x63; }
c_transpiler_aes_inverse_sbox :: (value:u8)->u8 { for candidate:0..255 if c_transpiler_aes_sbox(cast(u8)candidate)==value return cast(u8)candidate; return 0; }
c_transpiler_aes_mix_columns :: (input:[16]u8, inverse:bool)->[16]u8 { result:[16]u8; for column:0..3 { i:=column*4; a:=input[i]; b:=input[i+1]; c:=input[i+2]; d:=input[i+3]; if !inverse { result[i]=c_transpiler_aes_multiply(a,2)^c_transpiler_aes_multiply(b,3)^c^d; result[i+1]=a^c_transpiler_aes_multiply(b,2)^c_transpiler_aes_multiply(c,3)^d; result[i+2]=a^b^c_transpiler_aes_multiply(c,2)^c_transpiler_aes_multiply(d,3); result[i+3]=c_transpiler_aes_multiply(a,3)^b^c^c_transpiler_aes_multiply(d,2); } else { result[i]=c_transpiler_aes_multiply(a,14)^c_transpiler_aes_multiply(b,11)^c_transpiler_aes_multiply(c,13)^c_transpiler_aes_multiply(d,9); result[i+1]=c_transpiler_aes_multiply(a,9)^c_transpiler_aes_multiply(b,14)^c_transpiler_aes_multiply(c,11)^c_transpiler_aes_multiply(d,13); result[i+2]=c_transpiler_aes_multiply(a,13)^c_transpiler_aes_multiply(b,9)^c_transpiler_aes_multiply(c,14)^c_transpiler_aes_multiply(d,11); result[i+3]=c_transpiler_aes_multiply(a,11)^c_transpiler_aes_multiply(b,13)^c_transpiler_aes_multiply(c,9)^c_transpiler_aes_multiply(d,14); } } return result; }
c_transpiler_aes_round :: (value:[2]s64, key:[2]s64, inverse:bool, last:bool)->[2]s64 { source:=cast(*u8)*value; shifted:[16]u8; for column:0..3 for row:0..3 { source_column:=ifx inverse then (column-row+4)%4 else (column+row)%4; byte:=source[row+4*source_column]; shifted[row+4*column]=ifx inverse then c_transpiler_aes_inverse_sbox(byte) else c_transpiler_aes_sbox(byte); } transformed:=ifx last then shifted else c_transpiler_aes_mix_columns(shifted,inverse); result:[2]s64; memcpy(*result,*transformed,16); result[0]^=key[0]; result[1]^=key[1]; return result; }
c_transpiler_aesenc128 :: (value:[2]s64,key:[2]s64)->[2]s64 { return c_transpiler_aes_round(value,key,false,false); }
c_transpiler_aesenclast128 :: (value:[2]s64,key:[2]s64)->[2]s64 { return c_transpiler_aes_round(value,key,false,true); }
c_transpiler_aesdec128 :: (value:[2]s64,key:[2]s64)->[2]s64 { return c_transpiler_aes_round(value,key,true,false); }
c_transpiler_aesdeclast128 :: (value:[2]s64,key:[2]s64)->[2]s64 { return c_transpiler_aes_round(value,key,true,true); }
c_transpiler_aesimc128 :: (value:[2]s64)->[2]s64 { source:[16]u8; memcpy(*source,*value,16); transformed:=c_transpiler_aes_mix_columns(source,true); result:[2]s64; memcpy(*result,*transformed,16); return result; }
c_transpiler_aeskeygenassist128 :: (value:[2]s64,round_constant:s32)->[2]s64 { source:=cast(*u8)*value; result:[2]s64; bytes:=cast(*u8)*result; for output_word:0..1 { start:=ifx output_word==0 then 4 else 12; destination:=output_word*8; s0:=c_transpiler_aes_sbox(source[start]); s1:=c_transpiler_aes_sbox(source[start+1]); s2:=c_transpiler_aes_sbox(source[start+2]); s3:=c_transpiler_aes_sbox(source[start+3]); bytes[destination]=s0; bytes[destination+1]=s1; bytes[destination+2]=s2; bytes[destination+3]=s3; bytes[destination+4]=s1^cast(u8)round_constant; bytes[destination+5]=s2; bytes[destination+6]=s3; bytes[destination+7]=s0; } return result; }
c_transpiler_float_equal :: inline (a: float32, b: float32) -> bool { #if CPU == .X64 { mask: u32 = ---; #asm SSE { movd left:, a; movd right:, b; cmpss left, right, 0; movd mask, left; } return mask != 0; } else return (c_transpiler_isnan(a) == 0 && c_transpiler_isnan(b) == 0) && (a == b); }
c_transpiler_float_not_equal :: inline (a: float32, b: float32) -> bool { #if CPU == .X64 { mask: u32 = ---; #asm SSE { movd left:, a; movd right:, b; cmpss left, right, 4; movd mask, left; } return mask != 0; } else return (c_transpiler_isnan(a) != 0 || c_transpiler_isnan(b) != 0) || (a != b); }
c_transpiler_float_less :: inline (a: float32, b: float32) -> bool { #if CPU == .X64 { result: u32 = ---; #asm SSE { movd left:, a; movd right:, b; cmpss left, right, 1; movd result, left; } return result != 0; } else return (c_transpiler_isnan(a) == 0 && c_transpiler_isnan(b) == 0) && (a < b); }
c_transpiler_float_less_equal :: inline (a: float32, b: float32) -> bool { #if CPU == .X64 { result: u32 = ---; #asm SSE { movd left:, a; movd right:, b; cmpss left, right, 2; movd result, left; } return result != 0; } else return (c_transpiler_isnan(a) == 0 && c_transpiler_isnan(b) == 0) && (a <= b); }
c_transpiler_float_greater :: inline (a: float32, b: float32) -> bool { #if CPU == .X64 { result: u32 = ---; #asm SSE { movd left:, b; movd right:, a; cmpss left, right, 1; movd result, left; } return result != 0; } else return (c_transpiler_isnan(a) == 0 && c_transpiler_isnan(b) == 0) && (a > b); }
c_transpiler_float_greater_equal :: inline (a: float32, b: float32) -> bool { #if CPU == .X64 { result: u32 = ---; #asm SSE { movd left:, b; movd right:, a; cmpss left, right, 2; movd result, left; } return result != 0; } else return (c_transpiler_isnan(a) == 0 && c_transpiler_isnan(b) == 0) && (a >= b); }
c_transpiler_float_equal :: inline (a: float64, b: float64) -> bool { #if CPU == .X64 { mask: u64 = ---; #asm SSE { movq left:, a; movq right:, b; cmpsd left, right, 0; movq mask, left; } return mask != 0; } else return (c_transpiler_isnan(a) == 0 && c_transpiler_isnan(b) == 0) && (a == b); }
c_transpiler_float_not_equal :: inline (a: float64, b: float64) -> bool { #if CPU == .X64 { mask: u64 = ---; #asm SSE { movq left:, a; movq right:, b; cmpsd left, right, 4; movq mask, left; } return mask != 0; } else return (c_transpiler_isnan(a) != 0 || c_transpiler_isnan(b) != 0) || (a != b); }
c_transpiler_float_less :: inline (a: float64, b: float64) -> bool { #if CPU == .X64 { result: u64 = ---; #asm SSE { movq left:, a; movq right:, b; cmpsd left, right, 1; movq result, left; } return result != 0; } else return (c_transpiler_isnan(a) == 0 && c_transpiler_isnan(b) == 0) && (a < b); }
c_transpiler_float_less_equal :: inline (a: float64, b: float64) -> bool { #if CPU == .X64 { result: u64 = ---; #asm SSE { movq left:, a; movq right:, b; cmpsd left, right, 2; movq result, left; } return result != 0; } else return (c_transpiler_isnan(a) == 0 && c_transpiler_isnan(b) == 0) && (a <= b); }
c_transpiler_float_greater :: inline (a: float64, b: float64) -> bool { #if CPU == .X64 { result: u64 = ---; #asm SSE { movq left:, b; movq right:, a; cmpsd left, right, 1; movq result, left; } return result != 0; } else return (c_transpiler_isnan(a) == 0 && c_transpiler_isnan(b) == 0) && (a > b); }
c_transpiler_float_greater_equal :: inline (a: float64, b: float64) -> bool { #if CPU == .X64 { result: u64 = ---; #asm SSE { movq left:, b; movq right:, a; cmpsd left, right, 2; movq result, left; } return result != 0; } else return (c_transpiler_isnan(a) == 0 && c_transpiler_isnan(b) == 0) && (a >= b); }
c_transpiler_isfinite :: (value: float64) -> s32 { bits := (cast(*u64) *value).*; return ifx (bits & 0x7ff0000000000000) != 0x7ff0000000000000 then cast(s32) 1 else cast(s32) 0; }
c_transpiler_isfinite :: (value: float32) -> s32 { bits := (cast(*u32) *value).*; return ifx (bits & 0x7f800000) != 0x7f800000 then cast(s32) 1 else cast(s32) 0; }
c_transpiler_isfinite :: (value: C_Transpiler_Long_Double) -> s32 { return c_transpiler_isfinite(c_transpiler_long_double_to_float64(value)); }
is_finite_number :: c_transpiler_isfinite;
c_transpiler_isnormal :: (value: float64) -> s32 { bits := (cast(*u64) *value).* & 0x7fffffffffffffff; exponent := bits & 0x7ff0000000000000; return ifx exponent != 0 && exponent != 0x7ff0000000000000 then cast(s32) 1 else cast(s32) 0; }
c_transpiler_isnormal :: (value: float32) -> s32 { bits := (cast(*u32) *value).* & 0x7fffffff; exponent := bits & 0x7f800000; return ifx exponent != 0 && exponent != 0x7f800000 then cast(s32) 1 else cast(s32) 0; }
c_transpiler_isnormal :: (value: C_Transpiler_Long_Double) -> s32 { return c_transpiler_isnormal(c_transpiler_long_double_to_float64(value)); }
c_transpiler_isnan :: (value: float64) -> s32 { bits := (cast(*u64) *value).*; return ifx (bits & 0x7ff0000000000000) == 0x7ff0000000000000 && (bits & 0xfffffffffffff) != 0 then cast(s32) 1 else cast(s32) 0; }
c_transpiler_isnan :: (value: float32) -> s32 { bits := (cast(*u32) *value).*; return ifx (bits & 0x7f800000) == 0x7f800000 && (bits & 0x7fffff) != 0 then cast(s32) 1 else cast(s32) 0; }
c_transpiler_isnan :: (value: C_Transpiler_Long_Double) -> s32 { return c_transpiler_isnan(c_transpiler_long_double_to_float64(value)); }
c_transpiler_isinf_sign :: (value: float64) -> s32 { bits := (cast(*u64) *value).*; if (bits & 0x7fffffffffffffff) != 0x7ff0000000000000 return 0; return ifx (bits >> 63) != 0 then cast(s32) -1 else cast(s32) 1; }
c_transpiler_isinf_sign :: (value: float32) -> s32 { bits := (cast(*u32) *value).*; if (bits & 0x7fffffff) != 0x7f800000 return 0; return ifx (bits >> 31) != 0 then cast(s32) -1 else cast(s32) 1; }
c_transpiler_isinf_sign :: (value: C_Transpiler_Long_Double) -> s32 { return c_transpiler_isinf_sign(c_transpiler_long_double_to_float64(value)); }
c_transpiler_signbit :: (value: float64) -> s32 { bits := (cast(*u64) *value).*; return cast(s32) (bits >> 63); }
c_transpiler_signbit :: (value: float32) -> s32 { bits := (cast(*u32) *value).*; return cast(s32) (bits >> 31); }
c_transpiler_signbit :: (value: C_Transpiler_Long_Double) -> s32 { return c_transpiler_signbit(c_transpiler_long_double_to_float64(value)); }
c_transpiler_fabs :: (value: float64) -> float64 { bits := (cast(*u64) *value).* & 0x7fffffffffffffff; return (cast(*float64) *bits).*; }
c_transpiler_fabs :: (value: float32) -> float32 { bits := (cast(*u32) *value).* & 0x7fffffff; return (cast(*float32) *bits).*; }
c_transpiler_fabs :: (value: C_Transpiler_Long_Double) -> C_Transpiler_Long_Double { return ifx c_transpiler_signbit(value) != 0 then -value else value; }
c_transpiler_copysign :: (magnitude: float64, sign: float64) -> float64 { magnitude_bits := (cast(*u64) *magnitude).* & 0x7fffffffffffffff; sign_bits := (cast(*u64) *sign).* & 0x8000000000000000; result := magnitude_bits | sign_bits; return (cast(*float64) *result).*; }
c_transpiler_copysign :: (magnitude: float32, sign: float32) -> float32 { magnitude_bits := (cast(*u32) *magnitude).* & 0x7fffffff; sign_bits := (cast(*u32) *sign).* & 0x80000000; result := magnitude_bits | sign_bits; return (cast(*float32) *result).*; }
c_transpiler_copysign :: (magnitude: C_Transpiler_Long_Double, sign: C_Transpiler_Long_Double) -> C_Transpiler_Long_Double { absolute := c_transpiler_fabs(magnitude); return ifx c_transpiler_signbit(sign) != 0 then -absolute else absolute; }
c_transpiler_float_divide :: (left: float64, right: float64) -> float64 { return left / right; }
c_transpiler_float_divide :: (left: float32, right: float32) -> float32 { return left / right; }
c_transpiler_nan_f32 :: () -> float32 { bits: u32 = 0x7fc00000; return (cast(*float32) *bits).*; }
c_transpiler_infinity_f32 :: () -> float32 { bits: u32 = 0x7f800000; return (cast(*float32) *bits).*; }
c_transpiler_nan_f64 :: () -> float64 { bits: u64 = 0x7ff8000000000000; return (cast(*float64) *bits).*; }
c_transpiler_infinity_f64 :: () -> float64 { bits: u64 = 0x7ff0000000000000; return (cast(*float64) *bits).*; }
c_transpiler_fpclassify :: (nan_class: s32, infinite_class: s32, normal_class: s32, subnormal_class: s32, zero_class: s32, value: float64) -> s32 { bits := (cast(*u64) *value).* & 0x7fffffffffffffff; exponent := bits & 0x7ff0000000000000; fraction := bits & 0xfffffffffffff; if exponent == 0x7ff0000000000000 return ifx fraction != 0 then nan_class else infinite_class; if bits == 0 return zero_class; if exponent == 0 return subnormal_class; return normal_class; }
c_transpiler_fpclassify :: (nan_class: s32, infinite_class: s32, normal_class: s32, subnormal_class: s32, zero_class: s32, value: float32) -> s32 { bits := (cast(*u32) *value).* & 0x7fffffff; exponent := bits & 0x7f800000; fraction := bits & 0x7fffff; if exponent == 0x7f800000 return ifx fraction != 0 then nan_class else infinite_class; if bits == 0 return zero_class; if exponent == 0 return subnormal_class; return normal_class; }
c_transpiler_fpclassify :: (nan_class: s32, infinite_class: s32, normal_class: s32, subnormal_class: s32, zero_class: s32, value: C_Transpiler_Long_Double) -> s32 { return c_transpiler_fpclassify(nan_class, infinite_class, normal_class, subnormal_class, zero_class, c_transpiler_long_double_to_float64(value)); }
c_transpiler_abort :: () { assert(false, "c_transpiler: C/C++ abort or trap"); }
c_transpiler_unreachable :: () { assert(false, "c_transpiler: reached C undefined-unreachable path"); }
unreachable_value :: ($T: Type) -> T { assert(false, "non-void C/C++ control flow reached the end of the function"); result: T = ---; return result; }
c_transpiler_pre_increment :: (value: *$T) -> T { value.* += 1; return value.*; }
c_transpiler_post_increment :: (value: *$T) -> T { result := value.*; value.* += 1; return result; }
c_transpiler_pre_decrement :: (value: *$T) -> T { value.* -= 1; return value.*; }
c_transpiler_post_decrement :: (value: *$T) -> T { result := value.*; value.* -= 1; return result; }
c_transpiler_numeric_cast :: (value: $S, $T: Type) -> T { #if T == C_Transpiler_Long_Double return c_transpiler_long_double(value); else #if T == U128 return c_transpiler_to_u128(value); else #if T == S128 return c_transpiler_to_s128(value); else #if S == C_Transpiler_Long_Double return cast,no_check(T) c_transpiler_long_double_to_float64(value); else #if S == U128 return cast,no_check(T) value.low; else #if S == S128 return cast,no_check(T) value.low; else return cast,no_check(T) value; }
c_transpiler_assign :: (destination: *$T, source: $S) -> T { destination.* = c_transpiler_numeric_cast(source, T); return destination.*; }
c_transpiler_assign_add :: (destination: *$T, source: $S) -> T { destination.* = destination.* + c_transpiler_numeric_cast(source, T); return destination.*; }
c_transpiler_assign_sub :: (destination: *$T, source: $S) -> T { destination.* = destination.* - c_transpiler_numeric_cast(source, T); return destination.*; }
c_transpiler_pointer_assign_add :: (destination: **$T, source: $S) -> *T { destination.* += cast(s64) source; return destination.*; }
c_transpiler_pointer_assign_sub :: (destination: **$T, source: $S) -> *T { destination.* -= cast(s64) source; return destination.*; }
c_transpiler_assign_mul :: (destination: *$T, source: $S) -> T { destination.* *= cast,no_check(T) source; return destination.*; }
c_transpiler_assign_div :: (destination: *$T, source: $S) -> T { destination.* /= cast,no_check(T) source; return destination.*; }
c_transpiler_assign_mod :: (destination: *$T, source: $S) -> T { destination.* %= cast,no_check(T) source; return destination.*; }
c_transpiler_assign_xor :: (destination: *$T, source: $S) -> T { destination.* ^= cast,no_check(T) source; return destination.*; }
c_transpiler_assign_shl :: (destination: *$T, source: $S) -> T { destination.* <<= cast,no_check(T) source; return destination.*; }
c_transpiler_assign_shr :: (destination: *$T, source: $S) -> T { destination.* >>= cast,no_check(T) source; return destination.*; }
c_transpiler_assign_or :: (destination: *$T, source: $S) -> T { destination.* |= cast,no_check(T) source; return destination.*; }
c_transpiler_assign_and :: (destination: *$T, source: $S) -> T { destination.* &= cast,no_check(T) source; return destination.*; }
c_transpiler_compound_add :: (destination: *$T, source: $S, $L: Type, $R: Type) -> T { destination.* = c_transpiler_numeric_cast(c_transpiler_numeric_cast(destination.*, L) + c_transpiler_numeric_cast(source, R), T); return destination.*; }
c_transpiler_compound_sub :: (destination: *$T, source: $S, $L: Type, $R: Type) -> T { destination.* = c_transpiler_numeric_cast(c_transpiler_numeric_cast(destination.*, L) - c_transpiler_numeric_cast(source, R), T); return destination.*; }
c_transpiler_compound_mul :: (destination: *$T, source: $S, $L: Type, $R: Type) -> T { destination.* = c_transpiler_numeric_cast(c_transpiler_numeric_cast(destination.*, L) * c_transpiler_numeric_cast(source, R), T); return destination.*; }
c_transpiler_compound_div :: (destination: *$T, source: $S, $L: Type, $R: Type) -> T { destination.* = c_transpiler_numeric_cast(c_transpiler_numeric_cast(destination.*, L) / c_transpiler_numeric_cast(source, R), T); return destination.*; }
c_transpiler_compound_mod :: (destination: *$T, source: $S, $L: Type, $R: Type) -> T { left: L = c_transpiler_numeric_cast(destination.*, L); right: R = c_transpiler_numeric_cast(source, R); destination.* = cast,no_check(T) (left % right); return destination.*; }
c_transpiler_compound_xor :: (destination: *$T, source: $S, $L: Type, $R: Type) -> T { left: L = c_transpiler_numeric_cast(destination.*, L); right: R = c_transpiler_numeric_cast(source, R); destination.* = cast,no_check(T) (left ^ right); return destination.*; }
c_transpiler_compound_shl :: (destination: *$T, source: $S, $L: Type, $R: Type) -> T { left: L = c_transpiler_numeric_cast(destination.*, L); right: R = c_transpiler_numeric_cast(source, R); destination.* = cast,no_check(T) (left << right); return destination.*; }
c_transpiler_compound_shr :: (destination: *$T, source: $S, $L: Type, $R: Type) -> T { left: L = c_transpiler_numeric_cast(destination.*, L); right: R = c_transpiler_numeric_cast(source, R); destination.* = cast,no_check(T) (left >> right); return destination.*; }
c_transpiler_compound_or :: (destination: *$T, source: $S, $L: Type, $R: Type) -> T { left: L = c_transpiler_numeric_cast(destination.*, L); right: R = c_transpiler_numeric_cast(source, R); destination.* = cast,no_check(T) (left | right); return destination.*; }
c_transpiler_compound_and :: (destination: *$T, source: $S, $L: Type, $R: Type) -> T { left: L = c_transpiler_numeric_cast(destination.*, L); right: R = c_transpiler_numeric_cast(source, R); destination.* = cast,no_check(T) (left & right); return destination.*; }
c_transpiler_vector_add :: inline (left: [$N] $L, right: [N] $R, $T: Type) -> [N] T { result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] + right[lane]); return result; }
c_transpiler_vector_compound_add :: inline (source: [$N] $S, destination: *[N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] + source[lane]); destination.* = result; return result; }
c_transpiler_vector_compound_add_scalar :: inline (source: $S, destination: *[$N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] + source); destination.* = result; return result; }
c_transpiler_vector_sub :: inline (left: [$N] $L, right: [N] $R, $T: Type) -> [N] T { result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] - right[lane]); return result; }
c_transpiler_vector_compound_sub :: inline (source: [$N] $S, destination: *[N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] - source[lane]); destination.* = result; return result; }
c_transpiler_vector_compound_sub_scalar :: inline (source: $S, destination: *[$N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] - source); destination.* = result; return result; }
c_transpiler_vector_mul :: inline (left: [$N] $L, right: [N] $R, $T: Type) -> [N] T { result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] * right[lane]); return result; }
c_transpiler_vector_compound_mul :: inline (source: [$N] $S, destination: *[N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] * source[lane]); destination.* = result; return result; }
c_transpiler_vector_compound_mul_scalar :: inline (source: $S, destination: *[$N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] * source); destination.* = result; return result; }
c_transpiler_vector_div :: inline (left: [$N] $L, right: [N] $R, $T: Type) -> [N] T { result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] / right[lane]); return result; }
c_transpiler_vector_compound_div :: inline (source: [$N] $S, destination: *[N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] / source[lane]); destination.* = result; return result; }
c_transpiler_vector_compound_div_scalar :: inline (source: $S, destination: *[$N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] / source); destination.* = result; return result; }
c_transpiler_vector_mod :: inline (left: [$N] $L, right: [N] $R, $T: Type) -> [N] T { result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] % right[lane]); return result; }
c_transpiler_vector_compound_mod :: inline (source: [$N] $S, destination: *[N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] % source[lane]); destination.* = result; return result; }
c_transpiler_vector_compound_mod_scalar :: inline (source: $S, destination: *[$N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] % source); destination.* = result; return result; }
c_transpiler_vector_xor :: inline (left: [$N] $L, right: [N] $R, $T: Type) -> [N] T { result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] ^ right[lane]); return result; }
c_transpiler_vector_compound_xor :: inline (source: [$N] $S, destination: *[N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] ^ source[lane]); destination.* = result; return result; }
c_transpiler_vector_compound_xor_scalar :: inline (source: $S, destination: *[$N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] ^ source); destination.* = result; return result; }
c_transpiler_vector_shl :: inline (left: [$N] $L, right: [N] $R, $T: Type) -> [N] T { result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] << right[lane]); return result; }
c_transpiler_vector_compound_shl :: inline (source: [$N] $S, destination: *[N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] << source[lane]); destination.* = result; return result; }
c_transpiler_vector_compound_shl_scalar :: inline (source: $S, destination: *[$N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] << source); destination.* = result; return result; }
c_transpiler_vector_shr :: inline (left: [$N] $L, right: [N] $R, $T: Type) -> [N] T { result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] >> right[lane]); return result; }
c_transpiler_vector_compound_shr :: inline (source: [$N] $S, destination: *[N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] >> source[lane]); destination.* = result; return result; }
c_transpiler_vector_compound_shr_scalar :: inline (source: $S, destination: *[$N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] >> source); destination.* = result; return result; }
c_transpiler_vector_or :: inline (left: [$N] $L, right: [N] $R, $T: Type) -> [N] T { result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] | right[lane]); return result; }
c_transpiler_vector_compound_or :: inline (source: [$N] $S, destination: *[N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] | source[lane]); destination.* = result; return result; }
c_transpiler_vector_compound_or_scalar :: inline (source: $S, destination: *[$N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] | source); destination.* = result; return result; }
c_transpiler_vector_and :: inline (left: [$N] $L, right: [N] $R, $T: Type) -> [N] T { result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] & right[lane]); return result; }
c_transpiler_vector_compound_and :: inline (source: [$N] $S, destination: *[N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] & source[lane]); destination.* = result; return result; }
c_transpiler_vector_compound_and_scalar :: inline (source: $S, destination: *[$N] $T) -> [N] T { left := destination.*; result: [N] T; for lane: 0..N-1 result[lane] = cast,no_check(T) (left[lane] & source); destination.* = result; return result; }
c_transpiler_malloc :: (size: u64) -> *void { return c_transpiler_libc_malloc(size); }
c_transpiler_calloc :: (count: u64, size: u64) -> *void { return c_transpiler_libc_calloc(count, size); }
c_transpiler_free :: (memory: *void) { c_transpiler_libc_free(memory); }
c_transpiler_realloc :: (memory: *void, size: u64) -> *void { return c_transpiler_libc_realloc(memory, size); }
c_transpiler_allocate_memory :: (size: $Size) -> *void { return c_transpiler_malloc(cast(u64) size); }
c_transpiler_allocate_zeroed_memory :: (count: $Count, size: $Size) -> *void { return c_transpiler_calloc(cast(u64) count, cast(u64) size); }
c_transpiler_deallocate_memory :: (memory: *$Memory) { c_transpiler_free(cast(*void) memory); }
c_transpiler_reallocate_memory :: (memory: *$Memory, size: $Size) -> *void { return c_transpiler_realloc(cast(*void) memory, cast(u64) size); }
read_bytes :: (fd: s32, buffer: *$Buffer, count: $Count) -> s64 { return c_transpiler_libc_read(fd, cast(*void) buffer, cast(u64) count); }
write_bytes :: (fd: s32, buffer: *$Buffer, count: $Count) -> s64 { return c_transpiler_libc_write(fd, cast(*void) buffer, cast(u64) count); }
c_transpiler_strlen :: (text: *s8) -> u64 { result: u64; if !text return 0; while text[result] != 0 result += 1; return result; }
cstring_length :: c_transpiler_strlen;
c_transpiler_printf_plain :: (format: *s8) -> s32 { count := c_transpiler_strlen(format); write_string(string.{data = cast(*u8) format, count = cast(s64) count}); return cast(s32) count; }
c_transpiler_printf_write_unsigned :: (
    output: *C_Transpiler_Basic.String_Builder,
    value: u64,
    base: s32,
    width: s32,
    precision: s32,
    left_justify: bool,
    zero_padding: bool,
    alternate_form: bool,
    uppercase: bool,
) -> s32 {
    reversed_digits: [64] u8;
    digit_count: s32;
    remaining := value;
    if remaining == 0 {
        reversed_digits[0] = #char "0";
        digit_count = 1;
    } else while remaining != 0 {
        digit := cast(u8) (remaining % cast(u64) base);
        reversed_digits[digit_count] = cast(u8) (ifx digit < 10
            then #char "0" + digit
            else (ifx uppercase then #char "A" else #char "a") + digit - 10);
        digit_count += 1;
        remaining /= cast(u64) base;
    }

    prefix_count: s32;
    prefix_second: u8;
    if alternate_form && value != 0 {
        if base == 8 prefix_count = 1;
        else if base == 16 {
            prefix_count = 2;
            prefix_second = cast(u8) (ifx uppercase then #char "X" else #char "x");
        }
    }
    minimum_digits := max(digit_count, ifx precision >= 0 then precision else 1);
    zero_count := minimum_digits - digit_count;
    space_count := max(cast(s32) 0, width - prefix_count - minimum_digits);
    if zero_padding && !left_justify && precision < 0 {
        zero_count += space_count;
        space_count = 0;
    }

    if !left_justify c_transpiler_printf_write_padding(output, space_count, #char " ");
    if prefix_count {
        append(output, #char "0");
        if prefix_count == 2 append(output, prefix_second);
    }
    c_transpiler_printf_write_padding(output, zero_count, #char "0");
    for index: 0..digit_count-1
        append(output, reversed_digits[digit_count - index - 1]);
    if left_justify c_transpiler_printf_write_padding(output, space_count, #char " ");
    return prefix_count + zero_count + digit_count + space_count;
}
c_transpiler_strnlen :: (text: *s8, maximum: u64) -> u64 { result: u64; if !text return 0; while result < maximum && text[result] != 0 result += 1; return result; }
c_transpiler_strcpy :: (destination: *s8, source: *s8) -> *s8 { index: u64; while true { destination[index] = source[index]; if source[index] == 0 break; index += 1; } return destination; }
copy_cstring :: c_transpiler_strcpy;
c_transpiler_strncpy :: (destination: *s8, source: *s8, count: u64) -> *s8 { index: u64; while index < count && source[index] != 0 { destination[index] = source[index]; index += 1; } while index < count { destination[index] = 0; index += 1; } return destination; }
copy_cstring_up_to :: c_transpiler_strncpy;
c_transpiler_strcmp :: (left: *s8, right: *s8) -> s32 { index: u64; while cast,no_check(u8) left[index] == cast,no_check(u8) right[index] { if left[index] == 0 return 0; index += 1; } return cast(s32) cast,no_check(u8) left[index] - cast(s32) cast,no_check(u8) right[index]; }
compare_cstrings :: c_transpiler_strcmp;
c_transpiler_strncmp :: (left: *s8, right: *s8, count: u64) -> s32 { index: u64; while index < count { left_byte := cast,no_check(u8) left[index]; right_byte := cast,no_check(u8) right[index]; if left_byte != right_byte return cast(s32) left_byte - cast(s32) right_byte; if left_byte == 0 return 0; index += 1; } return 0; }
compare_cstrings_up_to :: c_transpiler_strncmp;
c_transpiler_puts :: (text: *s8) -> s32 { print("%\n", to_string(cast(*u8) text)); return 0; }
c_transpiler_write_character :: (value: u8) { write_string(string.{data = *value, count = 1}); }
c_transpiler_printf_is_digit :: (value: s8) -> bool {
    return value >= #char "0" && value <= #char "9";
}

c_transpiler_printf_write_padding :: (output: *C_Transpiler_Basic.String_Builder, amount: s32, value: u8) {
    if amount <= 0 return;
    for padding_index: 0..amount-1 append(output, value);
}

c_transpiler_printf_write_text :: (
    output: *C_Transpiler_Basic.String_Builder,
    text: string,
    width: s32,
    left_justify: bool,
    padding: u8 = #char " ",
    uppercase_hex: bool = false,
) -> s32 {
    padding_count := width - cast(s32) text.count;
    if padding_count < 0 padding_count = 0;
    if !left_justify c_transpiler_printf_write_padding(output, padding_count, padding);
    if uppercase_hex {
        for byte: text {
            uppercase_byte := byte;
            if uppercase_byte >= #char "a" && uppercase_byte <= #char "f" uppercase_byte -= 32;
            append(output, uppercase_byte);
        }
    } else append(output, text);
    if left_justify c_transpiler_printf_write_padding(output, padding_count, #char " ");
    return cast(s32) text.count + padding_count;
}

c_transpiler_format_state :: (
    format: *s8,
    state: *C_Transpiler_Va_State,
    output: *C_Transpiler_Basic.String_Builder,
) -> s32 {
    count: s32;
    cursor := format;
    while cursor.* != 0 {
        if cursor.* != #char "%" {
            append(output, cast(u8) cursor.*);
            cursor += 1;
            count += 1;
            continue;
        }
        cursor += 1;
        if cursor.* == #char "%" {
            append(output, #char "%");
            cursor += 1;
            count += 1;
            continue;
        }

        left_justify := false;
        force_sign := false;
        space_sign := false;
        alternate_form := false;
        zero_padding := false;
        while true {
            if cursor.* == #char "-" left_justify = true;
            else if cursor.* == #char "+" force_sign = true;
            else if cursor.* == #char " " space_sign = true;
            else if cursor.* == #char "#" alternate_form = true;
            else if cursor.* == #char "0" zero_padding = true;
            else break;
            cursor += 1;
        }

        width: s32;
        if cursor.* == #char "*" {
            width_argument := state.arguments[state.index];
            state.index += 1;
            width = (cast(*s32) width_argument.value_pointer).*;
            if width < 0 { left_justify = true; width = -width; }
            cursor += 1;
        } else while c_transpiler_printf_is_digit(cursor.*) {
            width = width * 10 + cast(s32) (cursor.* - #char "0");
            cursor += 1;
        }

        precision: s32 = -1;
        if cursor.* == #char "." {
            cursor += 1;
            precision = 0;
            if cursor.* == #char "*" {
                precision_argument := state.arguments[state.index];
                state.index += 1;
                precision = (cast(*s32) precision_argument.value_pointer).*;
                cursor += 1;
            } else while c_transpiler_printf_is_digit(cursor.*) {
                precision = precision * 10 + cast(s32) (cursor.* - #char "0");
                cursor += 1;
            }
        }

        wide_integer := false;
        if cursor.* == #char "z" || cursor.* == #char "j" || cursor.* == #char "t" {
            wide_integer = true;
            cursor += 1;
        } else if cursor.* == #char "l" {
            wide_integer = true;
            cursor += 1;
            if cursor.* == #char "l" cursor += 1;
        } else if cursor.* == #char "h" {
            cursor += 1;
            if cursor.* == #char "h" cursor += 1;
        } else if cursor.* == #char "L" {
            cursor += 1;
        }

        specifier := cursor.*;
        if specifier == 0 break;
        cursor += 1;
        if state.index >= state.arguments.count {
            append(output, #char "%");
            append(output, cast(u8) specifier);
            count += 2;
            continue;
        }
        argument := state.arguments[state.index];
        state.index += 1;

        if specifier == #char "d" || specifier == #char "i" {
            value: s64;
            if wide_integer value = (cast(*s64) argument.value_pointer).*;
            else value = cast(s64) (cast(*s32) argument.value_pointer).*;
            text := tprint("%", value);
            if value >= 0 && force_sign text = tprint("+%", text);
            else if value >= 0 && space_sign text = tprint(" %", text);
            padding := cast(u8) (ifx zero_padding && !left_justify then #char "0" else #char " ");
            count += c_transpiler_printf_write_text(output, text, width, left_justify, padding);
        } else if specifier == #char "u" || specifier == #char "x" ||
                  specifier == #char "X" || specifier == #char "o" {
            value: u64;
            if wide_integer value = (cast(*u64) argument.value_pointer).*;
            else value = cast(u64) (cast(*u32) argument.value_pointer).*;
            base := 10;
            if specifier == #char "x" || specifier == #char "X" base = 16;
            else if specifier == #char "o" base = 8;
            count += c_transpiler_printf_write_unsigned(
                output, value, cast(s32) base, width, precision, left_justify,
                zero_padding, alternate_form, specifier == #char "X",
            );
        } else if specifier == #char "f" || specifier == #char "F" ||
                  specifier == #char "e" || specifier == #char "E" ||
                  specifier == #char "g" || specifier == #char "G" {
            value := (cast(*float64) argument.value_pointer).*;
            digits := ifx precision >= 0 then precision else 6;
            text: string;
            if specifier == #char "f" || specifier == #char "F"
                text = tprint("%", formatFloat(value, trailing_width = digits, zero_removal = .NO));
            else if specifier == #char "e" || specifier == #char "E"
                text = tprint("%", formatFloat(value, trailing_width = digits,
                                                mode = .SCIENTIFIC, zero_removal = .NO));
            else
                text = tprint("%", formatFloat(value, trailing_width = digits,
                                                mode = .SHORTEST));
            if value >= 0 && force_sign text = tprint("+%", text);
            else if value >= 0 && space_sign text = tprint(" %", text);
            padding := cast(u8) (ifx zero_padding && !left_justify then #char "0" else #char " ");
            count += c_transpiler_printf_write_text(
                output, text, width, left_justify, padding,
                specifier == #char "E" || specifier == #char "G",
            );
        } else if specifier == #char "s" {
            value := (cast(**s8) argument.value_pointer).*;
            text := ifx value then to_string(cast(*u8) value) else "(null)";
            if precision >= 0 && text.count > precision
                text.count = precision;
            count += c_transpiler_printf_write_text(output, text, width, left_justify);
        } else if specifier == #char "c" {
            value := cast(u8) (cast(*s32) argument.value_pointer).*;
            text := string.{data = *value, count = 1};
            count += c_transpiler_printf_write_text(output, text, width, left_justify);
        } else if specifier == #char "p" {
            value := cast(u64) (cast(**void) argument.value_pointer).*;
            text := tprint("0x%", formatInt(value, base = 16));
            count += c_transpiler_printf_write_text(output, text, width, left_justify);
        } else {
            append(output, #char "%");
            append(output, cast(u8) specifier);
            count += 2;
        }
    }
    return count;
}
c_transpiler_printf_state :: (format: *s8, state: *C_Transpiler_Va_State) -> s32 {
    output: C_Transpiler_Basic.String_Builder;
    defer reset(*output);
    count := c_transpiler_format_state(format, state, *output);
    buffer := get_base_buffer(*output);
    while buffer {
        write_string(string.{data = get_buffer_data(buffer), count = buffer.count});
        buffer = buffer.next;
    }
    return count;
}

c_transpiler_printf :: (format: *s8, args: ..Any) -> s32 {
    state := C_Transpiler_Va_State.{arguments = args};
    return c_transpiler_printf_state(format, *state);
}

c_transpiler_vprintf :: (format: *s8, storage: *void) -> s32 {
    return c_transpiler_printf_state(
        format, cast(*C_Transpiler_Va_State) storage,
    );
}

c_transpiler_vfprintf :: (
    stream: *C_Transpiler_POSIX.FILE,
    format: *s8,
    storage: *void,
) -> s32 {
    output: C_Transpiler_Basic.String_Builder;
    defer reset(*output);
    count := c_transpiler_format_state(
        format, cast(*C_Transpiler_Va_State) storage, *output,
    );
    buffer := get_base_buffer(*output);
    while buffer {
        C_Transpiler_POSIX.fwrite(
            cast(*void) get_buffer_data(buffer), 1, cast(u64) buffer.count, stream,
        );
        buffer = buffer.next;
    }
    return count;
}

c_transpiler_vsnprintf :: (
    destination: *s8,
    capacity: u64,
    format: *s8,
    storage: *void,
) -> s32 {
    output: C_Transpiler_Basic.String_Builder;
    defer reset(*output);
    count := c_transpiler_format_state(
        format, cast(*C_Transpiler_Va_State) storage, *output,
    );
    remaining := ifx capacity then capacity - 1 else cast(u64) 0;
    written: u64;
    buffer := get_base_buffer(*output);
    while buffer && remaining {
        available := cast(u64) buffer.count;
        amount := min(available, remaining);
        memcpy(
            cast(*void) (destination + written),
            cast(*void) get_buffer_data(buffer),
            cast(s64) amount,
        );
        written += amount;
        remaining -= amount;
        buffer = buffer.next;
    }
    if capacity destination[written] = 0;
    return count;
}
print_variadic_arguments :: c_transpiler_vprintf;
print_variadic_arguments_to_file :: c_transpiler_vfprintf;
format_cstring_from_variadic_arguments :: c_transpiler_vsnprintf;
c_transpiler_putchar :: (value: s32) -> s32 { c_transpiler_write_character(cast(u8) value); return value; }
c_transpiler_memcpy :: (destination: *void, source: *void, count: u64) -> *void { memcpy(destination, source, cast(s64) count); return destination; }
copy_memory :: (destination: *$Destination, source: *$Source, count: $Count) -> *void { return c_transpiler_memcpy(cast(*void) destination, cast(*void) source, cast(u64) count); }
c_transpiler_mempcpy :: (destination: *void, source: *void, count: u64) -> *void { memcpy(destination, source, cast(s64) count); return cast(*u8) destination + count; }
c_transpiler_memmove :: (destination: *void, source: *void, count: u64) -> *void { target := cast(*u8) destination; input := cast(*u8) source; if target < input || target >= input + count { memcpy(destination, source, cast(s64) count); } else if count { for index: 0..cast(s64) count-1 target[count-1-cast(u64) index] = input[count-1-cast(u64) index]; } return destination; }
c_transpiler_memset :: (destination: *void, value: s32, count: u64) -> *void { memset(destination, cast,no_check(u8) value, cast(s64) count); return destination; }
move_memory :: (destination: *$Destination, source: *$Source, count: $Count) -> *void { return c_transpiler_memmove(cast(*void) destination, cast(*void) source, cast(u64) count); }
fill_memory :: (destination: *$Destination, value: s32, count: $Count) -> *void { return c_transpiler_memset(cast(*void) destination, value, cast(u64) count); }
c_transpiler_memcmp :: (left: *void, right: *void, count: u64) -> s32 { return cast(s32) memcmp(left, right, cast(s64) count); }
c_transpiler_memchr :: (memory: *void, value: s32, count: u64) -> *void { bytes := cast(*u8) memory; for index: 0..cast(s64) count-1 if bytes[index] == cast,no_check(u8) value return *bytes[index]; return null; }
c_transpiler_strchr :: (text: *s8, value: s32) -> *s8 { while true { if text.* == cast,no_check(s8) value return text; if text.* == 0 return null; text += 1; } return null; }
c_transpiler_strrchr :: (text: *s8, value: s32) -> *s8 { result: *s8; while true { if text.* == cast,no_check(s8) value result = text; if text.* == 0 return result; text += 1; } return result; }
c_transpiler_strcspn :: (text: *s8, rejected: *s8) -> u64 { count: u64; while text[count] { if c_transpiler_strchr(rejected, text[count]) return count; count += 1; } return count; }
c_transpiler_strspn :: (text: *s8, accepted: *s8) -> u64 { count: u64; while text[count] { if !c_transpiler_strchr(accepted, text[count]) return count; count += 1; } return count; }
c_transpiler_strstr :: (text: *s8, needle: *s8) -> *s8 { if needle.* == 0 return text; while text.* { index: u64; while needle[index] != 0 && text[index] == needle[index] index += 1; if needle[index] == 0 return text; text += 1; } return null; }
cstring_span_until_any :: c_transpiler_strcspn;
cstring_span_while_any :: c_transpiler_strspn;
find_cstring :: c_transpiler_strstr;
c_transpiler_strdup :: (text: *s8) -> *s8 { count := c_transpiler_strlen(text) + 1; result := cast(*s8) c_transpiler_malloc(count); return c_transpiler_strcpy(result, text); }
c_transpiler_strndup :: (text: *s8, maximum: u64) -> *s8 { count := min(c_transpiler_strlen(text), maximum); result := cast(*s8) c_transpiler_malloc(count + 1); memcpy(result, text, cast(s64) count); result[count] = 0; return result; }
c_transpiler_stpcpy :: (destination: *s8, source: *s8) -> *s8 { count := c_transpiler_strlen(source); memcpy(destination, source, cast(s64) count + 1); return destination + count; }
C_Transpiler_Wide_Integer :: struct { negative: bool; magnitude: U128; above_u128: bool; }
c_transpiler_wide_unsigned :: (value: u64) -> C_Transpiler_Wide_Integer { return .{magnitude = .{value, 0}}; }
c_transpiler_wide_unsigned_128 :: (value: U128) -> C_Transpiler_Wide_Integer { return .{magnitude = value}; }
c_transpiler_wide_signed :: (value: s64) -> C_Transpiler_Wide_Integer { if value >= 0 return .{magnitude = .{cast(u64) value, 0}}; magnitude := cast(u64) (-(value + 1)) + 1; return .{negative = true, magnitude = .{magnitude, 0}}; }
c_transpiler_wide_signed_128 :: (value: S128) -> C_Transpiler_Wide_Integer { bits := cast,force(U128) value; if value.high >= 0 return .{magnitude = bits}; magnitude := U128.{} - bits; return .{negative = true, magnitude = magnitude}; }
c_transpiler_wide_negate :: (value: C_Transpiler_Wide_Integer) -> C_Transpiler_Wide_Integer { result := value; if result.magnitude.low != 0 || result.magnitude.high != 0 result.negative = !result.negative; return result; }
c_transpiler_wide_add :: (left: C_Transpiler_Wide_Integer, right: C_Transpiler_Wide_Integer) -> C_Transpiler_Wide_Integer { if left.negative == right.negative { magnitude := left.magnitude + right.magnitude; return .{negative = left.negative, magnitude = magnitude, above_u128 = left.above_u128 || right.above_u128 || magnitude < left.magnitude}; } if left.magnitude >= right.magnitude return .{negative = left.negative, magnitude = left.magnitude - right.magnitude}; return .{negative = right.negative, magnitude = right.magnitude - left.magnitude}; }
c_transpiler_wide_mul :: (left: C_Transpiler_Wide_Integer, right: C_Transpiler_Wide_Integer) -> C_Transpiler_Wide_Integer { maximum := U128.{~cast(u64) 0, ~cast(u64) 0}; above := left.above_u128 || right.above_u128; if right.magnitude.low != 0 || right.magnitude.high != 0 above = above || left.magnitude > maximum / right.magnitude; magnitude := left.magnitude * right.magnitude; negative := left.negative != right.negative && (magnitude.low != 0 || magnitude.high != 0); return .{negative = negative, magnitude = magnitude, above_u128 = above}; }
c_transpiler_wide_limit :: (bits: u32, signed: bool, negative: bool) -> U128 { if bits == 128 { if !signed return .{0xffffffffffffffff, 0xffffffffffffffff}; if negative return .{0, 0x8000000000000000}; return .{0xffffffffffffffff, 0x7fffffffffffffff}; } if signed { if bits == 64 return ifx negative then U128.{0x8000000000000000, 0} else U128.{0x7fffffffffffffff, 0}; if negative return .{cast(u64) 1 << (bits - 1), 0}; return .{(cast(u64) 1 << (bits - 1)) - 1, 0}; } if bits == 64 return .{0xffffffffffffffff, 0}; return .{(cast(u64) 1 << bits) - 1, 0}; }
c_transpiler_wide_store :: (value: C_Transpiler_Wide_Integer, output: *$T, bits: u32, signed: bool) -> bool { wrapped := value.magnitude; if value.negative wrapped = U128.{} - wrapped; #if T == U128 { output.* = wrapped; } else #if T == S128 { output.* = cast,force(S128) wrapped; } else { output.* = cast,no_check(T) wrapped.low; } return value.above_u128 || (!signed && value.negative) || value.magnitude > c_transpiler_wide_limit(bits, signed, value.negative); }
c_transpiler_add_overflow :: (left: C_Transpiler_Wide_Integer, right: C_Transpiler_Wide_Integer, output: *$T, bits: u32, signed: bool) -> bool { return c_transpiler_wide_store(c_transpiler_wide_add(left, right), output, bits, signed); }
c_transpiler_sub_overflow :: (left: C_Transpiler_Wide_Integer, right: C_Transpiler_Wide_Integer, output: *$T, bits: u32, signed: bool) -> bool { return c_transpiler_wide_store(c_transpiler_wide_add(left, c_transpiler_wide_negate(right)), output, bits, signed); }
c_transpiler_mul_overflow :: (left: C_Transpiler_Wide_Integer, right: C_Transpiler_Wide_Integer, output: *$T, bits: u32, signed: bool) -> bool { return c_transpiler_wide_store(c_transpiler_wide_mul(left, right), output, bits, signed); }

c_transpiler_atomic_update :: (value: *$T, operand: $U, operation: u8) -> T { previous := atomic_load(value); while true { desired := previous; converted := cast,no_check(T) operand; if operation == 0 desired = previous + converted; else if operation == 1 desired = previous - converted; else if operation == 2 desired = previous | converted; else if operation == 3 desired = previous ^ converted; else if operation == 4 desired = previous & converted; else desired = ~(previous & converted); success, observed := compare_and_swap(value, previous, desired); if success return previous; previous = observed; } return previous; }
c_transpiler_atomic_fetch_add :: (value: *$T, operand: $U) -> T { return c_transpiler_atomic_update(value, operand, 0); }
c_transpiler_atomic_fetch_sub :: (value: *$T, operand: $U) -> T { return c_transpiler_atomic_update(value, operand, 1); }
c_transpiler_atomic_fetch_or :: (value: *$T, operand: $U) -> T { return c_transpiler_atomic_update(value, operand, 2); }
c_transpiler_atomic_fetch_xor :: (value: *$T, operand: $U) -> T { return c_transpiler_atomic_update(value, operand, 3); }
c_transpiler_atomic_fetch_and :: (value: *$T, operand: $U) -> T { return c_transpiler_atomic_update(value, operand, 4); }
c_transpiler_atomic_fetch_nand :: (value: *$T, operand: $U) -> T { return c_transpiler_atomic_update(value, operand, 5); }
c_transpiler_atomic_add_fetch :: (value: *$T, operand: $U) -> T { return c_transpiler_atomic_fetch_add(value, operand) + cast,no_check(T) operand; }
c_transpiler_atomic_sub_fetch :: (value: *$T, operand: $U) -> T { return c_transpiler_atomic_fetch_sub(value, operand) - cast,no_check(T) operand; }
c_transpiler_atomic_or_fetch :: (value: *$T, operand: $U) -> T { return c_transpiler_atomic_fetch_or(value, operand) | cast,no_check(T) operand; }
c_transpiler_atomic_xor_fetch :: (value: *$T, operand: $U) -> T { return c_transpiler_atomic_fetch_xor(value, operand) ^ cast,no_check(T) operand; }
c_transpiler_atomic_and_fetch :: (value: *$T, operand: $U) -> T { return c_transpiler_atomic_fetch_and(value, operand) & cast,no_check(T) operand; }
c_transpiler_atomic_nand_fetch :: (value: *$T, operand: $U) -> T { return ~(c_transpiler_atomic_fetch_nand(value, operand) & cast,no_check(T) operand); }
c_transpiler_atomic_compare_swap_value :: (value: *$T, expected: $U, desired: $V) -> T { _, previous := compare_and_swap(value, cast,no_check(T) expected, cast,no_check(T) desired); return previous; }
c_transpiler_atomic_compare_swap_bool :: (value: *$T, expected: $U, desired: $V) -> bool { success, _ := compare_and_swap(value, cast,no_check(T) expected, cast,no_check(T) desired); return success; }
c_transpiler_atomic_compare_exchange_n :: (value: *$T, expected: *T, desired: $V) -> bool { success, observed := compare_and_swap(value, expected.*, cast,no_check(T) desired); if !success expected.* = observed; return success; }
c_transpiler_atomic_compare_exchange :: (value: *$T, expected: *T, desired: *T) -> bool { success, observed := compare_and_swap(value, expected.*, desired.*); if !success expected.* = observed; return success; }
c_transpiler_atomic_exchange :: (value: *$T, desired: $U) -> T { return atomic_exchange(value, cast,no_check(T) desired); }
c_transpiler_atomic_store :: (value: *$T, desired: $U) -> T { converted := cast,no_check(T) desired; atomic_store(value, converted); return converted; }
c_transpiler_atomic_load_into :: (value: *$T, output: *T) { output.* = atomic_load(value); }
c_transpiler_atomic_store_indirect :: (value: *$T, desired: *T) { atomic_store(value, desired.*); }
c_transpiler_atomic_exchange_into :: (value: *$T, desired: *T, output: *T) { output.* = atomic_exchange(value, desired.*); }
c_transpiler_atomic_release :: (value: *$T) { atomic_store(value, cast,no_check(T) 0); }

c_transpiler_atomic_always_lock_free :: (size: u64) -> bool { return size == 1 || size == 2 || size == 4 || size == 8; }

